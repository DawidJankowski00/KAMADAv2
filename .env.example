# Copy to .env and adjust. docker compose reads .env automatically.
# All values below are safe development defaults; never commit a real .env.

POSTGRES_USER=kamada
POSTGRES_PASSWORD=kamada_dev
ASPNETCORE_ENVIRONMENT=Development

# API address used by the browser (frontends run in the browser, not in the container network)
PUBLIC_API_URL=http://localhost:5080/

# Route optimization: travel-time matrix provider (Osrm | Google | Haversine).
# Osrm defaults to the public demo server (development only, max 1 request/s).
ROUTE_MATRIX_PROVIDER=Osrm
OSRM_BASE_URL=https://router.project-osrm.org/
# Google Routes API key – only needed with ROUTE_MATRIX_PROVIDER=Google. Never commit it.
GOOGLE_ROUTES_API_KEY=
