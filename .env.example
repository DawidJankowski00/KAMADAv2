# Copy to .env and adjust. docker compose reads .env automatically.
# All values below are safe development defaults; never commit a real .env.

POSTGRES_USER=kamada
# Demo-only password; use a real secret outside local development.
POSTGRES_PASSWORD=kamada_dev
ASPNETCORE_ENVIRONMENT=Development

# API address used by the browser (frontends run in the browser, not in the container network)
PUBLIC_API_URL=http://localhost:5080/

# Route optimization: travel-time matrix provider (Osrm | Google | Haversine).
# Osrm defaults to the public demo server (development only, max 1 request/s).
ROUTE_MATRIX_PROVIDER=Osrm
OSRM_BASE_URL=https://router.project-osrm.org/
OSRM_MIN_DELAY=00:00:01
# Self-hosted OSRM (docker compose --profile osrm up --build): use the container and drop the throttle.
# OSRM_BASE_URL=http://osrm:5000/
# OSRM_MIN_DELAY=00:00:00
# Map for the OSRM container: Geofabrik voivodeship extracts, merged (space separated; changing the list re-prepares).
# OSRM_REGIONS=pomorskie zachodniopomorskie wielkopolskie kujawsko-pomorskie
# OSRM_GEOFABRIK_URL=https://download.geofabrik.de/europe/poland

# Google Routes API key – only needed with ROUTE_MATRIX_PROVIDER=Google. Never commit it.
GOOGLE_ROUTES_API_KEY=

# AI order assistant (local only, no cloud APIs): docker compose --profile ai up --build
# Set ASSISTANT_ENABLED=true to show the assistant in the admin panel. The model is pulled on first start.
ASSISTANT_ENABLED=false
# Any Ollama model with structured output; alternatives: gemma4:e4b, qwen3:4b, SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
OLLAMA_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://ollama:11434/
# Speech recognition (Whisper, runs inside the API): small (~470 MB, good Polish) or base (~140 MB, weak CPUs).
WHISPER_MODEL=small

# On-device assistant (phone app, works without a connection): docker compose --profile assistant up assistant-models
# downloads the models into a volume the phone app serves under /models; workers then pick them in the app's assistant settings.
# ASSISTANT_DEVICE_MODELS=Qwen3-1.7B-q4f16_1-MLC Qwen3-0.6B-q4f16_1-MLC onnx-community/whisper-base onnx-community/whisper-tiny
