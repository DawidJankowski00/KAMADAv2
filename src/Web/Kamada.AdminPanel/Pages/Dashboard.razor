@page "/"
@inject ApiClient Api

<PageTitle>Pulpit – KAMADA</PageTitle>

<PageHeader Title="Pulpit" Subtitle="Stan zamówień i dzisiejsze trasy">
    <Actions>
        <MudButton Href="orders/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart">Nowe zamówienie</MudButton>
    </Actions>
</PageHeader>

@if (_counts is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid>
        @foreach (var count in _counts)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Labels.Of(count.Status)</MudText>
                        <MudText Typo="Typo.h4">@count.Count</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="@($"orders?status={count.Status}")" Size="Size.Small" Color="Color.Primary">Pokaż</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <div class="d-flex align-center mt-6 mb-2">
        <MudText Typo="Typo.h6" Class="flex-grow-1">Trasy na dziś</MudText>
        <MudButton Href="@($"delivery-runs?date={Today:yyyy-MM-dd}")" Size="Size.Small" Color="Color.Primary">Wszystkie trasy z dziś</MudButton>
        <MudButton Href="delivery-runs/new" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddRoad" Class="ml-2">Nowa trasa</MudButton>
    </div>
    @if (_todayRuns.Count == 0)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Class="mud-text-secondary">Na dziś nie zaplanowano tras.</MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var run in _todayRuns)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.subtitle1" Class="flex-grow-1"><b>@run.Name</b></MudText>
                                <RunStatusChip Status="run.Status" />
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@run.CourierName · @run.VehiclePlate</MudText>
                            @if (run.StopCount > 0)
                            {
                                <MudProgressLinear Value="@(100.0 * (run.DeliveredCount + run.FailedCount) / run.StopCount)" Color="Color.Success" Class="my-2" Rounded="true" />
                            }
                            <MudText Typo="Typo.body2">
                                Przystanki: @run.StopCount (dostarczone @run.DeliveredCount, nieudane @run.FailedCount)
                                @if (run.PlannedDurationSeconds is { } seconds)
                                {
                                    @($" · {Labels.Duration(seconds)}, {Labels.Distance(run.PlannedDistanceMeters ?? 0)}")
                                }
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"delivery-runs/{run.Id}")" Size="Size.Small" Color="Color.Primary">Szczegóły</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private IReadOnlyList<OrderStatusCountDto>? _counts;
    private IReadOnlyList<DeliveryRunSummaryDto> _todayRuns = [];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<OrderStatusCountDto>>("api/orders/status-counts");
        var runs = await Api.GetAsync<PagedResult<DeliveryRunSummaryDto>>(
            $"api/delivery-runs{QueryString.Build(("from", Today), ("to", Today), ("pageSize", Paging.MaxPageSize))}");
        _todayRuns = runs.IsSuccess ? runs.Value.Items.Where(r => r.Status != DeliveryRunStatus.Cancelled).ToList() : [];
        _counts = result.IsSuccess ? result.Value : [];
    }
}
