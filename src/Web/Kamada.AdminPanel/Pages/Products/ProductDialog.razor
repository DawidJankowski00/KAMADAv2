@using Kamada.AdminPanel.Services
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_name" Label="Nazwa" Required="true" RequiredError="Podaj nazwę." MaxLength="200" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_sku" Label="SKU" Required="true" RequiredError="Podaj SKU." MaxLength="40"
                                  HelperText="Litery, cyfry i myślniki" Validation="@(new Func<string, string?>(ValidateSku))" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_price" Label="Cena brutto" Format="N2" Min="0.01m" Max="99999999.99m" Step="1m"
                                     Adornment="Adornment.End" AdornmentText="zł" Required="true" />
                </MudItem>
                @if (Product is null)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_stock" Label="Stan początkowy" Min="0" Max="1000000" Adornment="Adornment.End" AdornmentText="szt." />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudSelect T="Guid" Label="Kategorie" MultiSelection="true" @bind-SelectedValues="_categoryIds"
                               ToStringFunc="CategoryPath" Delimiter=", ">
                        @foreach (var category in Categories)
                        {
                            <MudSelectItem T="Guid" Value="category.Id">@category.Path</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_description" Label="Opis" Lines="3" MaxLength="4000" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private string _name = string.Empty;
    private string _sku = string.Empty;
    private decimal _price = 1m;
    private int _stock;
    private string? _description;
    private IReadOnlyCollection<Guid> _categoryIds = [];

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public IReadOnlyList<CategoryOption> Categories { get; set; } = [];

    /// <summary>Product to edit; null creates a new one.</summary>
    [Parameter] public ProductDto? Product { get; set; }

    protected override void OnInitialized()
    {
        if (Product is not null)
        {
            _name = Product.Name;
            _sku = Product.Sku;
            _price = Product.Price;
            _description = Product.Description;
            _categoryIds = Product.Categories.Select(c => c.Id).ToList();
        }
    }

    private static string? ValidateSku(string value) =>
        System.Text.RegularExpressions.Regex.IsMatch(value ?? string.Empty, "^[A-Za-z0-9-]+$") ? null : "Dozwolone są litery, cyfry i myślniki.";

    private string CategoryPath(Guid id) => Categories.FirstOrDefault(c => c.Id == id)?.Path ?? string.Empty;

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_valid)
        {
            return;
        }

        _busy = true;
        var categories = _categoryIds.ToList();
        var result = Product is null
            ? await Api.PostAsync<ProductDto>("api/products", new CreateProductRequest(_name, _description, _sku, _price, _stock, categories))
            : await Api.PutAsync<ProductDto>($"api/products/{Product.Id}", new UpdateProductRequest(_name, _description, _sku, _price, categories));
        _busy = false;

        if (Snackbar.Report(result))
        {
            Dialog.Close(DialogResult.Ok(result.Value));
        }
    }
}
