@page "/products"
@using Kamada.Web.Admin.Services
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Produkty – KAMADA</PageTitle>

<PageHeader Title="Produkty" Subtitle="Katalog, ceny i stany magazynowe">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">Dodaj produkt</MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="5">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Szukaj po nazwie lub SKU"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="300" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="Guid?" Value="_categoryId" ValueChanged="OnCategoryChanged" Label="Kategoria (z podkategoriami)" Clearable="true">
                @foreach (var category in _categories)
                {
                    <MudSelectItem T="Guid?" Value="category.Id">@category.Path</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="bool?" Value="_isActive" ValueChanged="OnActiveChanged" Label="Status">
                <MudSelectItem T="bool?" Value="null">Wszystkie</MudSelectItem>
                <MudSelectItem T="bool?" Value="true">Aktywne</MudSelectItem>
                <MudSelectItem T="bool?" Value="false">Nieaktywne</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable T="ProductDto" @ref="_table" ServerData="LoadAsync" Hover="true" Elevation="1" Dense="true" RowsPerPage="20" LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ProductDto" SortLabel="@nameof(ProductSortBy.Sku)">SKU</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ProductDto" SortLabel="@nameof(ProductSortBy.Name)" InitialDirection="SortDirection.Ascending">Nazwa</MudTableSortLabel></MudTh>
        <MudTh>Kategorie</MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="ProductDto" SortLabel="@nameof(ProductSortBy.Price)">Cena</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="ProductDto" SortLabel="@nameof(ProductSortBy.Stock)">Stan</MudTableSortLabel></MudTh>
        <MudTh>Status</MudTh>
        <MudTh Style="text-align:right">Akcje</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="SKU"><code>@context.Sku</code></MudTd>
        <MudTd DataLabel="Nazwa">@context.Name</MudTd>
        <MudTd DataLabel="Kategorie">
            @foreach (var category in context.Categories)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@category.Name</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Cena" Style="text-align:right">@Labels.Money(context.Price)</MudTd>
        <MudTd DataLabel="Stan" Style="text-align:right">
            <MudText Typo="Typo.body2" Color="@(context.StockQuantity == 0 ? Color.Error : context.StockQuantity < 5 ? Color.Warning : Color.Default)">@context.StockQuantity szt.</MudText>
        </MudTd>
        <MudTd DataLabel="Status">
            @if (context.IsActive)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">Aktywny</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small">Nieaktywny</MudChip>
            }
        </MudTd>
        <MudTd Style="text-align:right; white-space:nowrap">
            <MudTooltip Text="Edytuj"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" /></MudTooltip>
            <MudTooltip Text="Zmień stan magazynowy"><MudIconButton Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" OnClick="() => EditStockAsync(context)" /></MudTooltip>
            @if (context.IsActive)
            {
                <MudTooltip Text="Dezaktywuj"><MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small" OnClick="() => SetActiveAsync(context, false)" /></MudTooltip>
            }
            else
            {
                <MudTooltip Text="Aktywuj"><MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => SetActiveAsync(context, true)" /></MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">Brak produktów spełniających kryteria.</MudText></NoRecordsContent>
    <PagerContent><MudTablePager RowsPerPageString="Na stronie:" InfoFormat="{first_item}–{last_item} z {all_items}" /></PagerContent>
</MudTable>

@code {
    private MudTable<ProductDto>? _table;
    private IReadOnlyList<CategoryOption> _categories = [];
    private string? _search;
    private Guid? _categoryId;
    private bool? _isActive;

    protected override async Task OnInitializedAsync() => _categories = await CategoryOptions.LoadAsync(Api);

    private async Task<TableData<ProductDto>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        var sortBy = Enum.TryParse<ProductSortBy>(state.SortLabel, out var parsed) ? parsed : ProductSortBy.Name;
        var query = QueryString.Build(
            ("search", _search),
            ("categoryId", _categoryId),
            ("isActive", _isActive),
            ("sortBy", sortBy),
            ("descending", state.SortDirection == SortDirection.Descending),
            ("page", state.Page + 1),
            ("pageSize", state.PageSize));

        var result = await Api.GetAsync<PagedResult<ProductDto>>($"api/products{query}", cancellationToken);
        if (!Snackbar.Report(result))
        {
            return new TableData<ProductDto> { Items = [], TotalItems = 0 };
        }

        return new TableData<ProductDto> { Items = result.Value.Items, TotalItems = result.Value.TotalCount };
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return ReloadAsync();
    }

    private Task OnCategoryChanged(Guid? value)
    {
        _categoryId = value;
        return ReloadAsync();
    }

    private Task OnActiveChanged(bool? value)
    {
        _isActive = value;
        return ReloadAsync();
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters<ProductDialog> { { d => d.Categories, _categories } };
        if (await Dialogs.ShowForResultAsync<ProductDialog, ProductDto>("Nowy produkt", parameters, MaxWidth.Medium) is not null)
        {
            Snackbar.Add("Produkt został dodany.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task EditAsync(ProductDto product)
    {
        var parameters = new DialogParameters<ProductDialog>
        {
            { d => d.Categories, _categories },
            { d => d.Product, product },
        };
        if (await Dialogs.ShowForResultAsync<ProductDialog, ProductDto>($"Edycja: {product.Name}", parameters, MaxWidth.Medium) is not null)
        {
            Snackbar.Add("Zmiany zostały zapisane.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task EditStockAsync(ProductDto product)
    {
        var parameters = new DialogParameters<StockDialog> { { d => d.Product, product } };
        if (await Dialogs.ShowForResultAsync<StockDialog, bool>($"Stan magazynowy: {product.Sku}", parameters, MaxWidth.ExtraSmall))
        {
            Snackbar.Add("Stan magazynowy został zaktualizowany.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task SetActiveAsync(ProductDto product, bool active)
    {
        if (!active && !await Dialogs.ConfirmAsync("Dezaktywacja produktu", $"Produkt „{product.Name}” nie będzie dostępny w nowych zamówieniach. Kontynuować?", "Dezaktywuj", Color.Warning))
        {
            return;
        }

        var result = await Api.PostAsync($"api/products/{product.Id}/{(active ? "activate" : "deactivate")}");
        if (Snackbar.Report(result, active ? "Produkt aktywowany." : "Produkt dezaktywowany."))
        {
            await ReloadAsync();
        }
    }
}
