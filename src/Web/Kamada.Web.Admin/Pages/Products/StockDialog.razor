@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">@Product.Name</MudText>
        <MudNumericField @bind-Value="_quantity" Label="Stan magazynowy" Min="0" Max="1000000" Adornment="Adornment.End" AdornmentText="szt."
                         HelperText="Ustaw faktyczną liczbę sztuk (np. po inwentaryzacji lub dostawie)." AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private int _quantity;
    private bool _busy;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public ProductDto Product { get; set; } = default!;

    protected override void OnInitialized() => _quantity = Product.StockQuantity;

    private async Task SaveAsync()
    {
        _busy = true;
        var result = await Api.PutAsync($"api/products/{Product.Id}/stock", new SetStockRequest(_quantity));
        _busy = false;
        if (Snackbar.Report(result))
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }
}
