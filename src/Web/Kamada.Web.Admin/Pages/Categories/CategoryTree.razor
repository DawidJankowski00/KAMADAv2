@page "/categories"
@using Kamada.Web.Admin.Services
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Kategorie – KAMADA</PageTitle>

<PageHeader Title="Kategorie" Subtitle="Drzewo kategorii produktów">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => CreateAsync(null)">Kategoria główna</MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="pa-4" Elevation="1">
    @if (_tree is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_tree.Count == 0)
    {
        <MudText Class="mud-text-secondary">Brak kategorii. Dodaj pierwszą kategorię główną.</MudText>
    }
    else
    {
        <MudTreeView T="Guid" Dense="true" Hover="true">
            @RenderNodes(_tree)
        </MudTreeView>
    }
</MudPaper>

@code {
    private List<CategoryNodeDto>? _tree;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<CategoryNodeDto>>("api/categories");
        _tree = Snackbar.Report(result) ? result.Value : [];
    }

    private RenderFragment RenderNodes(IEnumerable<CategoryNodeDto> nodes) => __builder =>
    {
        foreach (var node in nodes)
        {
            <MudTreeViewItem T="Guid" @key="node.Id" Value="node.Id" Expanded="true" CanExpand="node.Children.Count > 0">
                <BodyContent>
                    <div class="d-flex align-center flex-grow-1 gap-2">
                        <MudText>@node.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@node.ProductCount prod.</MudChip>
                        <MudSpacer />
                        <MudTooltip Text="Dodaj podkategorię"><MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => CreateAsync(node)" /></MudTooltip>
                        <MudTooltip Text="Zmień nazwę / przenieś"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(node)" /></MudTooltip>
                        <MudTooltip Text="Usuń"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(node)" /></MudTooltip>
                    </div>
                </BodyContent>
                <ChildContent>
                    @RenderNodes(node.Children)
                </ChildContent>
            </MudTreeViewItem>
        }
    };

    private async Task CreateAsync(CategoryNodeDto? parent)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { d => d.Options, CategoryOptions.Flatten(_tree ?? []) },
            { d => d.ParentId, parent?.Id },
        };
        if (await Dialogs.ShowForResultAsync<CategoryDialog, bool>(parent is null ? "Nowa kategoria" : $"Nowa podkategoria: {parent.Name}", parameters, MaxWidth.ExtraSmall))
        {
            Snackbar.Add("Kategoria została dodana.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task EditAsync(CategoryNodeDto node)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { d => d.Options, CategoryOptions.Flatten(_tree ?? []) },
            { d => d.Category, node },
            { d => d.ParentId, node.ParentId },
        };
        if (await Dialogs.ShowForResultAsync<CategoryDialog, bool>($"Edycja: {node.Name}", parameters, MaxWidth.ExtraSmall))
        {
            Snackbar.Add("Kategoria została zapisana.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(CategoryNodeDto node)
    {
        if (!await Dialogs.ConfirmAsync("Usuwanie kategorii", $"Usunąć kategorię „{node.Name}”? Produkty pozostaną w katalogu, zostaną tylko odpięte od tej kategorii.", "Usuń", Color.Error))
        {
            return;
        }

        if (Snackbar.Report(await Api.DeleteAsync($"api/categories/{node.Id}"), "Kategoria została usunięta."))
        {
            await LoadAsync();
        }
    }
}
