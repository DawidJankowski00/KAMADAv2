@using Kamada.Web.Admin.Services
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Class="kamada-dialog-phone-fullscreen">
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Nazwa" Required="true" MaxLength="100" AutoFocus="true" />
        @if (Category is not null)
        {
            <MudSelect T="Guid?" @bind-Value="_parentId" Label="Kategoria nadrzędna" Clearable="true" Class="mt-4"
                       HelperText="Puste = kategoria główna">
                @foreach (var option in Options.Where(o => o.Id != Category.Id))
                {
                    <MudSelectItem T="Guid?" Value="option.Id">@option.Path</MudSelectItem>
                }
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy || string.IsNullOrWhiteSpace(_name)">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _name = string.Empty;
    private Guid? _parentId;
    private bool _busy;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public IReadOnlyList<CategoryOption> Options { get; set; } = [];

    /// <summary>Category to edit; null creates a new one under <see cref="ParentId"/>.</summary>
    [Parameter] public CategoryNodeDto? Category { get; set; }

    [Parameter] public Guid? ParentId { get; set; }

    protected override void OnInitialized()
    {
        _name = Category?.Name ?? string.Empty;
        _parentId = ParentId;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        ApiResult result = Category is null
            ? await Api.PostAsync<CategoryRefDto>("api/categories", new CreateCategoryRequest(_name, _parentId))
            : await Api.PutAsync($"api/categories/{Category.Id}", new UpdateCategoryRequest(_name, _parentId));
        _busy = false;

        if (Snackbar.Report(result))
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }
}
