@page "/clients/{Id:guid}"
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Klient – KAMADA</PageTitle>

@if (_client is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />
    <PageHeader Title="@($"{_client.Name} {_client.Surname}")" Subtitle="@($"{_client.Email} · {_client.PhoneNumber} · login: {_client.Username}")">
        <Actions>
            <MudButton Href="@($"orders/new?clientId={_client.Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart" Disabled="!_client.IsActive">Nowe zamówienie</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">Edytuj</MudButton>
            <MudButton Variant="Variant.Outlined" Color="@(_client.IsActive ? Color.Warning : Color.Success)" OnClick="ToggleActiveAsync">
                @(_client.IsActive ? "Dezaktywuj" : "Aktywuj")
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!_client.IsActive)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">Klient jest nieaktywny – nie można składać dla niego nowych zamówień.</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-4" Elevation="1">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">Adresy</MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.AddLocationAlt" Color="Color.Primary" OnClick="AddAddressAsync">Dodaj adres</MudButton>
                </div>
                @if (_client.Addresses.Count == 0)
                {
                    <MudText Class="mud-text-secondary">Brak adresów.</MudText>
                }
                <MudList T="AddressDto" Dense="true">
                    @foreach (var address in _client.Addresses)
                    {
                        <MudListItem T="AddressDto" Icon="@(address.Type == AddressType.Shipping ? Icons.Material.Filled.LocalShipping : Icons.Material.Filled.Receipt)">
                            <div class="d-flex flex-wrap align-center gap-2">
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body1">@Labels.Format(address)</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @Labels.Of(address.Type) ·
                                        @if (address.HasCoordinates)
                                        {
                                            <span>@Labels.Coordinates(address.Latitude!.Value, address.Longitude!.Value) (@(address.CoordinatesSource == CoordinatesSource.Manual ? "ręcznie" : "geokodowanie"))</span>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Error" Inline="true">bez współrzędnych – nie trafi do optymalizacji trasy</MudText>
                                        }
                                    </MudText>
                                </div>
                                <MudTooltip Text="Ustaw pinezkę na mapie"><MudIconButton Icon="@Icons.Material.Filled.PinDrop" Size="Size.Small" OnClick="() => PinAsync(address)" /></MudTooltip>
                                @if (!address.HasCoordinates)
                                {
                                    <MudTooltip Text="Ponów geokodowanie"><MudIconButton Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Small" OnClick="() => GeocodeAsync(address)" /></MudTooltip>
                                }
                                <MudTooltip Text="Edytuj"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAddressAsync(address)" /></MudTooltip>
                                <MudTooltip Text="Archiwizuj"><MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" OnClick="() => ArchiveAddressAsync(address)" /></MudTooltip>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>

            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">Zamówienia klienta</MudText>
                    <MudButton Href="@($"orders?clientId={_client.Id}")" Size="Size.Small">Wszystkie</MudButton>
                </div>
                @if (_orders is null)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_orders.Count == 0)
                {
                    <MudText Class="mud-text-secondary">Brak zamówień.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <tbody>
                            @foreach (var order in _orders)
                            {
                                <tr>
                                    <td>
                                        <MudLink Href="@($"orders/{order.Id}")">#@order.Number</MudLink>
                                        <MudText Typo="Typo.caption" Class="d-block d-sm-none mud-text-secondary">@Labels.DateTime(order.CreatedAt)</MudText>
                                    </td>
                                    <td class="d-none d-sm-table-cell">@Labels.DateTime(order.CreatedAt)</td>
                                    <td><OrderStatusChip Status="order.Status" /></td>
                                    <td style="text-align:right; white-space:nowrap">@Labels.Money(order.TotalAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-2" Elevation="1">
                <LeafletMap Markers="Markers" Height="var(--kamada-phone-map-height, 460px)" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private ClientDto? _client;
    private IReadOnlyList<OrderSummaryDto>? _orders;
    private List<BreadcrumbItem> _breadcrumbs = [];

    [Parameter] public Guid Id { get; set; }

    private IReadOnlyList<MapMarker> Markers =>
        _client?.Addresses
            .Where(a => a.HasCoordinates)
            .Select(a => new MapMarker(a.Latitude!.Value, a.Longitude!.Value, Labels.Format(a), a.Type == AddressType.Shipping ? MapMarkerKind.Stop : MapMarkerKind.Pin))
            .ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        var orders = await Api.GetAsync<PagedResult<OrderSummaryDto>>($"api/orders{QueryString.Build(("clientId", Id), ("pageSize", 10))}");
        _orders = orders.IsSuccess ? orders.Value.Items : [];
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<ClientDto>($"api/clients/{Id}");
        if (Snackbar.Report(result))
        {
            _client = result.Value;
            _breadcrumbs = [new("Klienci", "clients"), new($"{_client.Name} {_client.Surname}", null, disabled: true)];
        }
    }

    private async Task EditAsync()
    {
        var parameters = new DialogParameters<ClientDialog> { { d => d.Client, _client } };
        if (await Dialogs.ShowForResultAsync<ClientDialog, ClientDto>("Edycja klienta", parameters, MaxWidth.Medium) is { } updated)
        {
            _client = updated;
        }
    }

    private async Task ToggleActiveAsync()
    {
        var action = _client!.IsActive ? "deactivate" : "activate";
        if (Snackbar.Report(await Api.PostAsync($"api/clients/{Id}/{action}"), _client.IsActive ? "Klient dezaktywowany." : "Klient aktywowany."))
        {
            await LoadAsync();
        }
    }

    private async Task AddAddressAsync()
    {
        var parameters = new DialogParameters<AddressDialog> { { d => d.ClientId, Id } };
        if (await Dialogs.ShowForResultAsync<AddressDialog, AddressDto>("Nowy adres", parameters, MaxWidth.Medium) is not null)
        {
            await LoadAsync();
        }
    }

    private async Task EditAddressAsync(AddressDto address)
    {
        var parameters = new DialogParameters<AddressDialog> { { d => d.ClientId, Id }, { d => d.Address, address } };
        if (await Dialogs.ShowForResultAsync<AddressDialog, AddressDto>("Edycja adresu", parameters, MaxWidth.Medium) is not null)
        {
            await LoadAsync();
        }
    }

    private async Task PinAsync(AddressDto address)
    {
        var parameters = new DialogParameters<LocationDialog> { { d => d.ClientId, Id }, { d => d.Address, address } };
        if (await Dialogs.ShowForResultAsync<LocationDialog, AddressDto>("Lokalizacja adresu", parameters, MaxWidth.Medium) is not null)
        {
            await LoadAsync();
        }
    }

    private async Task GeocodeAsync(AddressDto address)
    {
        if (Snackbar.Report(await Api.PostAsync<AddressDto>($"api/clients/{Id}/addresses/{address.Id}/geocode"), "Współrzędne ustalone."))
        {
            await LoadAsync();
        }
    }

    private async Task ArchiveAddressAsync(AddressDto address)
    {
        if (!await Dialogs.ConfirmAsync("Archiwizacja adresu", $"Zarchiwizować adres {Labels.Format(address)}? Istniejące zamówienia zachowają swoją kopię adresu.", "Archiwizuj", Color.Warning))
        {
            return;
        }

        if (Snackbar.Report(await Api.DeleteAsync($"api/clients/{Id}/addresses/{address.Id}"), "Adres zarchiwizowany."))
        {
            await LoadAsync();
        }
    }
}
