@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="2">
                <AddressFields Model="_model" />
            </MudGrid>
        </MudForm>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">
            Po zapisaniu adres zostanie automatycznie zgeokodowany (OpenStreetMap). Jeśli się nie uda, ustawisz pinezkę ręcznie.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Zapisz
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private AddressModel _model = new();
    private MudForm? _form;
    private bool _valid;
    private bool _busy;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid ClientId { get; set; }

    /// <summary>Address to edit; null adds a new one.</summary>
    [Parameter] public AddressDto? Address { get; set; }

    protected override void OnInitialized()
    {
        if (Address is not null)
        {
            _model = AddressModel.From(Address);
        }
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_valid)
        {
            return;
        }

        _busy = true;
        var result = Address is null
            ? await Api.PostAsync<AddressDto>($"api/clients/{ClientId}/addresses", _model.ToRequest())
            : await Api.PutAsync<AddressDto>($"api/clients/{ClientId}/addresses/{Address.Id}", _model.ToRequest());
        _busy = false;

        if (!Snackbar.Report(result))
        {
            return;
        }

        if (!result.Value.HasCoordinates)
        {
            Snackbar.Add("Adres zapisano, ale nie udało się ustalić współrzędnych. Ustaw pinezkę na mapie.", Severity.Warning);
        }

        Dialog.Close(DialogResult.Ok(result.Value));
    }
}
