@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Class="kamada-dialog-phone-fullscreen">
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Pracownik zostanie wylogowany ze wszystkich urządzeń.</MudText>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_password" Label="Nowe hasło" InputType="InputType.Password" Required="true" MaxLength="128"
                          Validation="@(new Func<string, string?>(PasswordRules.Validate))" AutoFocus="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Ustaw hasło</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private string _password = string.Empty;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public WorkerDto Worker { get; set; } = default!;

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_valid)
        {
            return;
        }

        _busy = true;
        var result = await Api.PostAsync($"api/workers/{Worker.Id}/reset-password", new ResetPasswordRequest(_password));
        _busy = false;
        if (Snackbar.Report(result, "Hasło zostało zmienione."))
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }
}
