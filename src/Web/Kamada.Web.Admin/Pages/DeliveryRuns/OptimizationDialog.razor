@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Class="kamada-dialog-phone-fullscreen">
    <DialogContent>
        @if (_preview is null)
        {
            <div class="d-flex flex-column align-center pa-8 gap-3">
                @if (_failed)
                {
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                    <MudText>Nie udało się wyznaczyć trasy. Popraw dane i spróbuj ponownie.</MudText>
                }
                else
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText>Pobieram czasy przejazdu i szukam najlepszej kolejności…</MudText>
                }
            </div>
        }
        else
        {
            var optimized = _preview.Optimized;
            var current = _preview.Current;
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(Run.RoutePlan is null ? "Kolejność dodania" : "Obecna kolejność")</MudText>
                        <MudText Typo="Typo.h6">@Labels.Duration(current.TotalDurationSeconds)</MudText>
                        <MudText Typo="Typo.body2">@Labels.Distance(current.TotalDistanceMeters)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Outlined="true" Class="pa-3" Style="border-color:var(--mud-palette-primary)">
                        <MudText Typo="Typo.caption" Color="Color.Primary">Proponowana kolejność</MudText>
                        <MudText Typo="Typo.h6">@Labels.Duration(optimized.TotalDurationSeconds)</MudText>
                        <MudText Typo="Typo.body2">@Labels.Distance(optimized.TotalDistanceMeters)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Oszczędność</MudText>
                        @if (_preview.SavedSeconds >= 30)
                        {
                            <MudText Typo="Typo.h6" Color="Color.Success">
                                −@Labels.Duration(_preview.SavedSeconds) (@((_preview.SavedSeconds / current.TotalDurationSeconds).ToString("P0", Polish)))
                            </MudText>
                            <MudText Typo="Typo.body2" Color="@(_preview.SavedMeters >= 0 ? Color.Success : Color.Default)">
                                @(_preview.SavedMeters >= 0 ? "−" + Labels.Distance(_preview.SavedMeters) : $"+{Labels.Distance(-_preview.SavedMeters)} dłuższa, ale szybsza")
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">brak</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Obecna kolejność jest już najlepsza.</MudText>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <RoutePlanFlags Algorithm="@optimized.Algorithm" IsOptimal="optimized.IsOptimal" IsApproximate="optimized.IsApproximate"
                                    MatrixProvider="@optimized.MatrixProvider" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                        Łączny czas to czas jazdy od startu do końca (bez obsługi przystanków). Porównanie liczone na tej samej macierzy czasów przejazdu.
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSimpleTable Dense="true" Style="max-height:380px; overflow-y:auto">
                        <thead>
                            <tr><th>#</th><th>Zamówienie</th><th class="d-none d-sm-table-cell" style="text-align:right">Dojazd</th><th style="text-align:right">Przyjazd</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var planned in optimized.Stops)
                            {
                                var stop = StopOf(planned.OrderId);
                                var previous = CurrentPosition(planned.OrderId);
                                <tr>
                                    <td><b>@planned.Sequence</b></td>
                                    <td>
                                        <div>#@planned.OrderNumber @stop?.RecipientName</div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(stop is null ? string.Empty : Labels.Format(stop))</MudText>
                                    </td>
                                    <td class="d-none d-sm-table-cell" style="text-align:right; white-space:nowrap">@Labels.Duration(planned.LegDurationSeconds)<br /><MudText Typo="Typo.caption" Class="mud-text-secondary">@Labels.Distance(planned.LegDistanceMeters)</MudText></td>
                                    <td style="text-align:right; white-space:nowrap">+@Labels.Duration(planned.ArrivalOffsetSeconds)</td>
                                    <td>
                                        @if (previous != planned.Sequence)
                                        {
                                            <MudTooltip Text="@($"Wcześniej: {previous}. na trasie")">
                                                <MudIcon Icon="@(previous > planned.Sequence ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" Size="Size.Small" Color="Color.Info" />
                                            </MudTooltip>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td></td>
                                <td>
                                    Powrót: @Run.EndLocation.Name
                                    <MudText Typo="Typo.caption" Class="d-block d-sm-none mud-text-secondary">
                                        @Labels.Duration(optimized.ReturnLegDurationSeconds), @Labels.Distance(optimized.ReturnLegDistanceMeters)
                                    </MudText>
                                </td>
                                <td class="d-none d-sm-table-cell" style="text-align:right; white-space:nowrap">@Labels.Duration(optimized.ReturnLegDurationSeconds)<br /><MudText Typo="Typo.caption" Class="mud-text-secondary">@Labels.Distance(optimized.ReturnLegDistanceMeters)</MudText></td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <LeafletMap Markers="_markers" Route="_route" Height="var(--kamada-phone-map-height, 380px)" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@(_preview is null ? "Zamknij" : "Zostaw obecną")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApplyAsync" Disabled="_preview is null || _busy"
                   StartIcon="@Icons.Material.Filled.Check">
            Zastosuj optymalizację
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly System.Globalization.CultureInfo Polish = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");

    private RouteOptimizationPreviewDto? _preview;
    private IReadOnlyList<MapMarker> _markers = [];
    private IReadOnlyList<MapPoint> _route = [];
    private bool _failed;
    private bool _busy;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public DeliveryRunDto Run { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.PostAsync<RouteOptimizationPreviewDto>($"api/delivery-runs/{Run.Id}/optimize");
        if (!Snackbar.Report(result))
        {
            _failed = true;
            return;
        }

        _preview = result.Value;
        // Show the proposal on the map, using the coordinates the optimizer actually used.
        var proposed = _preview.Optimized.Stops
            .Select(p => StopOf(p.OrderId) is { } stop ? stop with { Latitude = p.Latitude, Longitude = p.Longitude } : null)
            .OfType<DeliveryStopDto>()
            .ToList();
        _markers = DeliveryRunMap.Markers(Run, proposed);
        _route = DeliveryRunMap.Route(Run, proposed);
    }

    private DeliveryStopDto? StopOf(Guid orderId) => Run.Stops.FirstOrDefault(s => s.OrderId == orderId);

    private int CurrentPosition(Guid orderId) =>
        _preview!.Current.Stops.FirstOrDefault(s => s.OrderId == orderId)?.Sequence ?? 0;

    private async Task ApplyAsync()
    {
        _busy = true;
        var result = await Api.PostAsync<DeliveryRunDto>($"api/delivery-runs/{Run.Id}/apply-optimization");
        _busy = false;
        if (Snackbar.Report(result, "Zapisano zoptymalizowaną kolejność przystanków."))
        {
            Dialog.Close(DialogResult.Ok(result.Value));
        }
    }
}
