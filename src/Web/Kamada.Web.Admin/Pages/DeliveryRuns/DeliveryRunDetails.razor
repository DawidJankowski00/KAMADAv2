@page "/delivery-runs/{Id:guid}"
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Trasa – KAMADA</PageTitle>

@if (_run is null)
{
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">Trasa nie istnieje. <MudLink Href="delivery-runs">Wróć do listy tras</MudLink>.</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" />
    }
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />
    <PageHeader Title="@_run.Name" Subtitle="@($"{Labels.Date(_run.PlannedDate)} · {_run.Courier.FullName} ({_run.Courier.PhoneNumber}) · {_run.VehiclePlate}")">
        <Actions>
            <RunStatusChip Status="_run.Status" />
            @if (IsDraft)
            {
                <MudButton Href="@($"delivery-runs/{Id}/edit")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit">Edytuj</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="OptimizeAsync"
                           Disabled="_run.Stops.Count == 0 || _busy">Optymalizuj trasę</MudButton>
                <MudTooltip Text="@(_run.RoutePlan is null ? "Najpierw zoptymalizuj trasę lub zapisz kolejność" : "Kurier zobaczy trasę w aplikacji")">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Send" OnClick="ApproveAsync"
                               Disabled="_run.RoutePlan is null || IsDirty || _busy">Zatwierdź</MudButton>
                </MudTooltip>
            }
            @if (_run.Status is DeliveryRunStatus.Draft or DeliveryRunStatus.Planned)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="CancelRunAsync" Disabled="_busy">Anuluj trasę</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Plan trasy</MudText>
                @if (_run.RoutePlan is { } plan)
                {
                    <div class="d-flex flex-wrap gap-6 mb-2">
                        <div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Czas jazdy</MudText>
                            <MudText Typo="Typo.h5">@Labels.Duration(plan.DurationSeconds)</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Dystans</MudText>
                            <MudText Typo="Typo.h5">@Labels.Distance(plan.DistanceMeters)</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Przystanki</MudText>
                            <MudText Typo="Typo.h5">@_run.Stops.Count</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Zaplanowano</MudText>
                            <MudText Typo="Typo.body1" Class="mt-1">@Labels.DateTime(plan.PlannedAt)</MudText>
                        </div>
                    </div>
                    <RoutePlanFlags Algorithm="@plan.Algorithm" IsOptimal="plan.IsOptimal" IsApproximate="plan.IsApproximate" MatrixProvider="@plan.MatrixProvider" />
                }
                else if (!IsDraft)
                {
                    <MudText Class="mud-text-secondary">Trasa nie ma zapisanego planu.</MudText>
                }
                else if (_run.Stops.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Dodaj zamówienia gotowe do wysyłki, a potem zoptymalizuj kolejność przystanków.</MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Kolejność przystanków nie jest jeszcze zaplanowana. Kliknij „Optymalizuj trasę” albo ułóż przystanki ręcznie i zapisz kolejność.
                    </MudAlert>
                }
                @if (IsDraft && StopsWithoutCoordinates.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        Adresy bez współrzędnych: @string.Join(", ", StopsWithoutCoordinates.Select(s => $"#{s.OrderNumber}")).
                        Wskaż je na mapie w karcie klienta (otwórz zamówienie → klient), inaczej trasy nie da się wyznaczyć.
                    </MudAlert>
                }
                @if (IsDraft && EndpointsWithoutCoordinates.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        @string.Join(", ", EndpointsWithoutCoordinates) – brak współrzędnych. <MudLink Href="route-locations">Wskaż lokalizację na mapie</MudLink>.
                    </MudAlert>
                }
            </MudPaper>

            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <div class="d-flex flex-wrap align-center gap-2 mb-2">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">Przystanki</MudText>
                    @if (IsDraft)
                    {
                        @if (IsDirty)
                        {
                            <MudButton Size="Size.Small" OnClick="ResetOrder" Disabled="_busy">Przywróć</MudButton>
                        }
                        @if (_order.Count > 0 && (IsDirty || _run.RoutePlan is null))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SaveOrderAsync" Disabled="_busy">Zapisz kolejność</MudButton>
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                   OnClick="AddOrdersAsync" Disabled="_busy">Dodaj zamówienia</MudButton>
                    }
                </div>

                <MudPaper Outlined="true" Class="pa-2 mb-2 d-flex align-center gap-2">
                    <MudAvatar Size="Size.Small" Style="background:#2e7d32;color:#fff">S</MudAvatar>
                    <div>
                        <MudText Typo="Typo.body2"><b>@_run.StartLocation.Name</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Labels.Format(_run.StartLocation)</MudText>
                    </div>
                </MudPaper>

                @if (_order.Count == 0)
                {
                    <MudText Class="mud-text-secondary pa-2">Brak przystanków.</MudText>
                }
                else if (IsDraft)
                {
                    @* Drag and drop needs a mouse; on touch screens the arrows reorder the stops. *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1 kamada-fine-pointer-only">Przeciągnij przystanek (lub użyj strzałek), aby zmienić kolejność, i zapisz.</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1 kamada-touch-only">Zmień kolejność strzałkami i zapisz.</MudText>
                    <MudDropContainer T="DeliveryStopDto" @key="_dropVersion" Items="_order" ItemsSelector="@((_, _) => true)" ItemDropped="OnStopDropped">
                        <ChildContent>
                            <MudDropZone T="DeliveryStopDto" Identifier="stops" AllowReorder="true" Class="d-flex flex-column gap-1 kamada-stop-zone" />
                        </ChildContent>
                        <ItemRenderer>
                            @{ var index = _order.IndexOf(context); }
                            <MudPaper Outlined="true" Class="pa-2 d-flex align-center gap-2 kamada-stop">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="mud-text-secondary kamada-fine-pointer-only" Style="cursor:grab" />
                                <MudAvatar Size="Size.Small" Color="Color.Primary">@(index + 1)</MudAvatar>
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body2"><MudLink Href="@($"orders/{context.OrderId}")">#@context.OrderNumber</MudLink> @context.RecipientName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Labels.Format(context)</MudText>
                                    @if (!context.HasCoordinates)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">Brak współrzędnych adresu</MudText>
                                    }
                                </div>
                                @if (!IsDirty && context.EstimatedArrivalOffsetSeconds is { } offset)
                                {
                                    <MudTooltip Text="Szacowany przyjazd od startu trasy (z czasem obsługi wcześniejszych przystanków)">
                                        <MudText Typo="Typo.caption" Style="white-space:nowrap">+@Labels.Duration(offset)</MudText>
                                    </MudTooltip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Disabled="index == 0 || _busy" OnClick="() => Move(context, -1)" aria-label="W górę" />
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Disabled="index == _order.Count - 1 || _busy" OnClick="() => Move(context, 1)" aria-label="W dół" />
                                <MudTooltip Text="Usuń z trasy">
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" Color="Color.Error" Disabled="_busy" OnClick="() => RemoveAsync(context)" />
                                </MudTooltip>
                            </MudPaper>
                        </ItemRenderer>
                    </MudDropContainer>
                }
                else
                {
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr><th>#</th><th>Zamówienie</th><th class="d-none d-sm-table-cell" style="text-align:right">Przyjazd</th><th class="d-none d-sm-table-cell">Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var stop in _order)
                            {
                                <tr>
                                    <td><b>@stop.Sequence</b></td>
                                    <td>
                                        <div><MudLink Href="@($"orders/{stop.OrderId}")">#@stop.OrderNumber</MudLink> @stop.RecipientName · @stop.PhoneNumber</div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Labels.Format(stop)</MudText>
                                        <div class="d-flex d-sm-none flex-wrap align-center gap-2 mt-1">
                                            <MudChip T="string" Size="Size.Small" Color="Labels.ColorOf(stop.Status)" Class="ma-0">@Labels.Of(stop.Status)</MudChip>
                                            @if (Arrival(stop) is { } arrival)
                                            {
                                                <MudText Typo="Typo.caption">@arrival</MudText>
                                            }
                                        </div>
                                        @if (stop.FailureReason is not null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">Powód: @stop.FailureReason</MudText>
                                        }
                                    </td>
                                    <td class="d-none d-sm-table-cell" style="text-align:right; white-space:nowrap">
                                        <span title="@(stop.DeliveredAt is null ? null : "Dostarczono")">@Arrival(stop)</span>
                                    </td>
                                    <td class="d-none d-sm-table-cell"><MudChip T="string" Size="Size.Small" Color="Labels.ColorOf(stop.Status)">@Labels.Of(stop.Status)</MudChip></td>
                                    <td>
                                        @if (stop.NavigationUrl is not null)
                                        {
                                            <MudTooltip Text="Nawiguj do tego przystanku">
                                                <MudIconButton Icon="@Icons.Material.Filled.Directions" Size="Size.Small" Href="@stop.NavigationUrl" Target="_blank" />
                                            </MudTooltip>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                <MudPaper Outlined="true" Class="pa-2 mt-2 d-flex align-center gap-2">
                    <MudAvatar Size="Size.Small" Style="background:#c62828;color:#fff">K</MudAvatar>
                    <div>
                        <MudText Typo="Typo.body2"><b>@_run.EndLocation.Name</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Labels.Format(_run.EndLocation)</MudText>
                    </div>
                </MudPaper>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-2" Elevation="1">
                <LeafletMap Markers="_markers" Route="_route" Height="var(--kamada-phone-map-height, 440px)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block pa-1">
                    Linie łączą kolejne punkty w prostej linii – dokładny przebieg drogi pokaże nawigacja.
                </MudText>
            </MudPaper>

            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Nawigacja Google Maps</MudText>
                @if (IsDirty)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Zapisz kolejność, aby odświeżyć linki.</MudText>
                }
                else
                {
                    <NavigationLinks Links="_run.NavigationLinks" StopCount="_run.Stops.Count" />
                }
            </MudPaper>

            @if (_run.StartedAt is not null || _run.CompletedAt is not null)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">Realizacja</MudText>
                    @if (_run.StartedAt is { } started)
                    {
                        <MudText Typo="Typo.body2">Rozpoczęta: @Labels.DateTime(started)</MudText>
                    }
                    @if (_run.CompletedAt is { } completed)
                    {
                        <MudText Typo="Typo.body2">Zakończona: @Labels.DateTime(completed)</MudText>
                    }
                    <MudText Typo="Typo.body2">
                        Dostarczone: @_run.Stops.Count(s => s.Status == DeliveryStopStatus.Delivered) ·
                        nieudane: @_run.Stops.Count(s => s.Status == DeliveryStopStatus.Failed) ·
                        oczekujące: @_run.Stops.Count(s => s.Status == DeliveryStopStatus.Pending)
                    </MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    private DeliveryRunDto? _run;
    private List<DeliveryStopDto> _order = [];
    private IReadOnlyList<MapMarker> _markers = [];
    private IReadOnlyList<MapPoint> _route = [];
    private List<BreadcrumbItem> _breadcrumbs = [];
    private int _dropVersion;
    private bool _notFound;
    private bool _busy;

    [Parameter] public Guid Id { get; set; }

    private bool IsDraft => _run?.Status == DeliveryRunStatus.Draft;

    /// <summary>The stop order was changed locally (drag &amp; drop / arrows) and not saved yet.</summary>
    private bool IsDirty => _run is not null && !_order.Select(s => s.Id).SequenceEqual(_run.Stops.OrderBy(s => s.Sequence).Select(s => s.Id));

    private List<DeliveryStopDto> StopsWithoutCoordinates => _order.Where(s => !s.HasCoordinates).ToList();

    /// <summary>Delivery time, otherwise the estimated arrival (clock time once the run started, offset before).</summary>
    private string? Arrival(DeliveryStopDto stop) => stop switch
    {
        { DeliveredAt: { } deliveredAt } => Labels.DateTime(deliveredAt),
        { EstimatedArrivalOffsetSeconds: { } offset } => _run!.StartedAt is { } startedAt
            ? $"~{startedAt.AddSeconds(offset).ToLocalTime():HH:mm}"
            : $"+{Labels.Duration(offset)}",
        _ => null,
    };

    private List<string> EndpointsWithoutCoordinates =>
        new[] { _run!.StartLocation, _run.EndLocation }.Where(l => !l.HasCoordinates).Select(l => l.Name).Distinct().ToList();

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<DeliveryRunDto>($"api/delivery-runs/{Id}");
        if (result.IsSuccess)
        {
            Show(result.Value);
        }
        else
        {
            _notFound = result.Problem!.Status == 404;
            Snackbar.Report(result);
        }
    }

    private void Show(DeliveryRunDto run)
    {
        _run = run;
        _order = run.Stops.OrderBy(s => s.Sequence).ToList();
        _breadcrumbs = [new("Trasy", "delivery-runs"), new(run.Name, null, disabled: true)];
        RefreshStops();
    }

    private void RefreshStops()
    {
        _dropVersion++;
        _markers = DeliveryRunMap.Markers(_run!, _order);
        _route = DeliveryRunMap.Route(_run!, _order);
    }

    private void OnStopDropped(MudItemDropInfo<DeliveryStopDto> drop)
    {
        if (drop.Item is null)
        {
            return;
        }

        _order.Remove(drop.Item);
        _order.Insert(Math.Clamp(drop.IndexInZone, 0, _order.Count), drop.Item);
        RefreshStops();
    }

    private void Move(DeliveryStopDto stop, int delta)
    {
        var index = _order.IndexOf(stop);
        var target = index + delta;
        if (index < 0 || target < 0 || target >= _order.Count)
        {
            return;
        }

        (_order[index], _order[target]) = (_order[target], _order[index]);
        RefreshStops();
    }

    private void ResetOrder()
    {
        _order = _run!.Stops.OrderBy(s => s.Sequence).ToList();
        RefreshStops();
    }

    private async Task RunAsync(Func<Task<ApiResult<DeliveryRunDto>>> call, string successMessage)
    {
        _busy = true;
        var result = await call();
        _busy = false;
        if (Snackbar.Report(result, successMessage))
        {
            Show(result.Value);
        }
    }

    private Task SaveOrderAsync() =>
        RunAsync(
            () => Api.PutAsync<DeliveryRunDto>($"api/delivery-runs/{Id}/sequence", new SetRunSequenceRequest(_order.Select(s => s.OrderId).ToList())),
            "Kolejność zapisana, czasy przyjazdu przeliczone.");

    private async Task<bool> DiscardLocalOrderAsync() =>
        !IsDirty || await Dialogs.ConfirmAsync("Niezapisana kolejność", "Ręcznie zmieniona kolejność nie została zapisana i zostanie odrzucona. Kontynuować?", "Kontynuuj", Color.Warning);

    private async Task AddOrdersAsync()
    {
        if (!await DiscardLocalOrderAsync())
        {
            return;
        }

        var parameters = new DialogParameters<AddOrdersDialog>
        {
            { d => d.RunId, Id },
            { d => d.CurrentStopCount, _run!.Stops.Count },
        };
        if (await Dialogs.ShowForResultAsync<AddOrdersDialog, DeliveryRunDto>("Dodaj zamówienia gotowe do wysyłki", parameters, MaxWidth.Medium) is { } updated)
        {
            Show(updated);
        }
    }

    private async Task RemoveAsync(DeliveryStopDto stop)
    {
        if (!await Dialogs.ConfirmAsync(
                "Usunięcie przystanku",
                $"Usunąć zamówienie #{stop.OrderNumber} ({stop.RecipientName}) z trasy? Wróci do puli „Gotowe do wysyłki”, a zapisany plan trasy zostanie wyczyszczony.",
                "Usuń",
                Color.Error))
        {
            return;
        }

        await RunAsync(() => Api.DeleteAsync<DeliveryRunDto>($"api/delivery-runs/{Id}/orders/{stop.OrderId}"), $"Usunięto zamówienie #{stop.OrderNumber} z trasy.");
    }

    private async Task OptimizeAsync()
    {
        if (!await DiscardLocalOrderAsync())
        {
            return;
        }

        ResetOrder();
        var parameters = new DialogParameters<OptimizationDialog> { { d => d.Run, _run! } };
        if (await Dialogs.ShowForResultAsync<OptimizationDialog, DeliveryRunDto>($"Optymalizacja: {_run!.Name}", parameters, MaxWidth.Large) is { } updated)
        {
            Show(updated);
        }
    }

    private async Task ApproveAsync()
    {
        if (await Dialogs.ConfirmAsync(
                "Zatwierdzenie trasy",
                $"Zatwierdzić trasę? {_run!.Courier.FullName} zobaczy ją w aplikacji kuriera. Po zatwierdzeniu nie można już zmieniać przystanków.",
                "Zatwierdź",
                Color.Success))
        {
            await RunAsync(() => Api.PostAsync<DeliveryRunDto>($"api/delivery-runs/{Id}/approve"), "Trasa zatwierdzona i widoczna dla kuriera.");
        }
    }

    private async Task CancelRunAsync()
    {
        if (await Dialogs.ConfirmAsync(
                "Anulowanie trasy",
                "Anulować trasę? Wszystkie jej zamówienia wrócą do puli „Gotowe do wysyłki”. Tej operacji nie można cofnąć.",
                "Anuluj trasę",
                Color.Error))
        {
            await RunAsync(() => Api.PostAsync<DeliveryRunDto>($"api/delivery-runs/{Id}/cancel"), "Trasa anulowana.");
        }
    }
}
