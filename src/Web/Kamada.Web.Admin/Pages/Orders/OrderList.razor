@page "/orders"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Zamówienia – KAMADA</PageTitle>

<PageHeader Title="Zamówienia" Subtitle="Filtruj po statusie, dacie, kliencie lub numerze">
    <Actions>
        <MudButton Href="orders/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart">Nowe zamówienie</MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Numer (#123) lub odbiorca"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="300" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="OrderStatus?" Value="_status" ValueChanged="OnStatusChanged" Label="Status" Clearable="true">
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <MudSelectItem T="OrderStatus?" Value="status">@Labels.Of(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="5">
            <MudDateRangePicker DateRange="_dateRange" DateRangeChanged="OnDateRangeChanged" Label="Data złożenia" Clearable="true"
                                Culture="@System.Globalization.CultureInfo.GetCultureInfo("pl-PL")" />
        </MudItem>
        @if (ClientId is not null)
        {
            <MudItem xs="12">
                <MudChip T="string" OnClose="ClearClientFilter" Color="Color.Primary" Variant="Variant.Outlined">Filtr: wybrany klient</MudChip>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

<MudTable T="OrderSummaryDto" @ref="_table" ServerData="LoadAsync" Hover="true" Elevation="1" Dense="true" RowsPerPage="20"
          OnRowClick="@(args => Navigation.NavigateTo($"orders/{args.Item!.Id}"))" RowClass="kamada-clickable-row">
    <HeaderContent>
        <MudTh>Numer</MudTh>
        <MudTh>Data</MudTh>
        <MudTh>Odbiorca</MudTh>
        <MudTh>Miasto</MudTh>
        <MudTh>Pozycje</MudTh>
        <MudTh Style="text-align:right">Wartość</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Numer"><b>#@context.Number</b></MudTd>
        <MudTd DataLabel="Data">@Labels.DateTime(context.CreatedAt)</MudTd>
        <MudTd DataLabel="Odbiorca">@context.RecipientName</MudTd>
        <MudTd DataLabel="Miasto">@context.City</MudTd>
        <MudTd DataLabel="Pozycje" HideSmall="true">@context.ItemCount</MudTd>
        <MudTd DataLabel="Wartość" Style="text-align:right">@Labels.Money(context.TotalAmount)</MudTd>
        <MudTd DataLabel="Status"><OrderStatusChip Status="context.Status" /></MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">Brak zamówień spełniających kryteria.</MudText></NoRecordsContent>
    <PagerContent><MudTablePager RowsPerPageString="Na stronie:" InfoFormat="{first_item}–{last_item} z {all_items}" /></PagerContent>
</MudTable>

@code {
    private MudTable<OrderSummaryDto>? _table;
    private string? _search;
    private OrderStatus? _status;
    private DateRange? _dateRange;

    [SupplyParameterFromQuery(Name = "status")] public string? StatusParameter { get; set; }

    [SupplyParameterFromQuery] public Guid? ClientId { get; set; }

    protected override void OnInitialized() =>
        _status = Enum.TryParse<OrderStatus>(StatusParameter, out var status) ? status : null;

    private async Task<TableData<OrderSummaryDto>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        // Date range is in local days; "to" is exclusive, so add one day.
        DateTimeOffset? from = _dateRange?.Start is { } start ? new DateTimeOffset(start.Date) : null;
        DateTimeOffset? to = _dateRange?.End is { } end ? new DateTimeOffset(end.Date.AddDays(1)) : null;

        var query = QueryString.Build(
            ("search", _search),
            ("status", _status),
            ("clientId", ClientId),
            ("from", from),
            ("to", to),
            ("page", state.Page + 1),
            ("pageSize", state.PageSize));

        var result = await Api.GetAsync<PagedResult<OrderSummaryDto>>($"api/orders{query}", cancellationToken);
        return Snackbar.Report(result)
            ? new TableData<OrderSummaryDto> { Items = result.Value.Items, TotalItems = result.Value.TotalCount }
            : new TableData<OrderSummaryDto> { Items = [], TotalItems = 0 };
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return _table!.ReloadServerData();
    }

    private Task OnStatusChanged(OrderStatus? value)
    {
        _status = value;
        return _table!.ReloadServerData();
    }

    private Task OnDateRangeChanged(DateRange? value)
    {
        _dateRange = value;
        return _table!.ReloadServerData();
    }

    private void ClearClientFilter() => Navigation.NavigateTo("orders");
}
