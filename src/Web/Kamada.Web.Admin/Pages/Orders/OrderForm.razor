@using Kamada.Web.Admin.Pages.Clients
@using Kamada.Web.Shared.Connectivity
@using Kamada.Web.Shared.Offline
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject ConnectionMonitor Monitor
@inject TimeProvider Clock
@inject IServiceProvider Services

@* The order form with the assistant, shared by the admin "new order" page and the seller's home in the phone app.
   It calls only endpoints open to sellers (SalesAccess). Where the host allows it (AllowQueue, the phone app's seller) a
   poor or missing connection switches it to the data kept on the phone, and the order is queued in the outbox. *@

<MudGrid>
    <MudItem xs="12" lg="8">
        @if (UseLocalData)
        {
            <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.CloudOff" Class="mb-4">
                Brak dobrego połączenia: klienci, ceny i stany pochodzą z danych zapisanych w telefonie (stan z @LocalDataTime).
                Zamówienie zostanie zapisane w telefonie i wysłane, gdy połączenie wróci. Asystent AI wymaga połączenia.
            </MudAlert>
        }
        else
        {
            @if (LocalDataMissing)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Słabe połączenie, a w telefonie nie ma jeszcze danych do pracy bez sieci – pobiorą się, gdy połączenie się poprawi.
                </MudAlert>
            }
            <AssistantPanel OnDraft="ApplyDraftAsync" />
        }

        @if (_warnings.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _warnings = []">
                <MudText Typo="Typo.subtitle2">Sprawdź przed złożeniem zamówienia:</MudText>
                <ul class="kamada-warning-list">
                    @foreach (var warning in _warnings)
                    {
                        <li>@Labels.Of(warning)</li>
                    }
                </ul>
            </MudAlert>
        }

        @* 1. Client *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex flex-wrap align-center gap-2 mb-2">
                <MudText Typo="Typo.h6">1. Klient</MudText>
                @if (_aiClient)
                {
                    <AiChip Uncertain="_clientUncertain" UncertainText="Pasuje kilku klientów albo dopasowanie jest niepewne – sprawdź." />
                }
                <MudSpacer />
                <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_newClientMode ? Variant.Text : Variant.Filled)"
                           StartIcon="@Icons.Material.Filled.PersonSearch" OnClick="() => _newClientMode = false">Istniejący klient</MudButton>
                <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_newClientMode ? Variant.Filled : Variant.Text)"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="() => _newClientMode = true">Nowy klient</MudButton>
            </div>

            @if (OtherCandidates.Count > 0)
            {
                <MudAlert Severity="@(_client is null && !_newClientMode ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-3">
                    <MudText Typo="Typo.body2"><b>@CandidatesTitle</b></MudText>
                    @foreach (var candidate in OtherCandidates)
                    {
                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => SelectCandidateAsync(candidate)">@candidate.DisplayName</MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                zgodność: @Labels.Of(candidate.Reason), @Labels.Score(candidate.Score)@(candidate.MatchedAddressId is null ? string.Empty : " · ten sam adres")
                            </MudText>
                        </div>
                    }
                </MudAlert>
            }

            @if (_newClientMode)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.PersonAdd" Class="mb-3">
                    Zostanie utworzony nowy klient.
                </MudAlert>
                <NewClientFields Model="_newClient" Changed="OnFormChanged" />
            }
            else
            {
                <MudAutocomplete T="ClientSummaryDto" Value="_client" ValueChanged="OnClientSelectedAsync" SearchFunc="SearchClientsAsync"
                                 ToStringFunc="@(c => c is null ? string.Empty : $"{c.Name} {c.Surname} ({c.Email})")"
                                 Label="Wyszukaj klienta" DebounceInterval="300" MinCharacters="2" ResetValueOnEmptyText="true"
                                 AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
            }
        </MudPaper>

        @* 2. Shipping address *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex align-center gap-2 mb-2">
                <MudText Typo="Typo.h6">2. Adres dostawy</MudText>
                @if (_aiAddress)
                {
                    <AiChip Uncertain="_newAddressPin is null && UsesNewAddress" UncertainText="Adresu nie udało się zweryfikować – uzupełnij brakujące pola." />
                }
            </div>

            @if (_newClientMode)
            {
                @NewAddressForm
            }
            else if (_clientDetails is null)
            {
                <MudText Class="mud-text-secondary">Najpierw wybierz klienta.</MudText>
            }
            else
            {
                <MudRadioGroup T="Guid?" @bind-Value="_addressId">
                    @foreach (var address in ShippingAddresses)
                    {
                        <div class="d-flex align-center">
                            <MudRadio T="Guid?" Value="address.Id" Color="Color.Primary">@Labels.Format(address)</MudRadio>
                            @if (!address.HasCoordinates)
                            {
                                <MudTooltip Text="Adres bez współrzędnych – zamówienie nie trafi do optymalizacji trasy, dopóki nie ustawisz pinezki.">
                                    <MudIcon Icon="@Icons.Material.Filled.WrongLocation" Color="Color.Warning" Size="Size.Small" />
                                </MudTooltip>
                            }
                        </div>
                    }
                    <MudRadio T="Guid?" Value="NewAddressOption" Color="Color.Primary">Nowy adres dostawy</MudRadio>
                </MudRadioGroup>

                @if (UsesNewAddress)
                {
                    @NewAddressForm
                }
            }
        </MudPaper>

        @* 3. Products *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex flex-wrap align-center gap-2 mb-2">
                <MudText Typo="Typo.h6">3. Produkty</MudText>
                @if (UseLocalData)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Inventory2">
                        ceny i stany z @LocalDataTime
                    </MudChip>
                }
            </div>
            <div class="d-flex flex-wrap align-end gap-3">
                <div class="flex-grow-1" style="min-width: 260px">
                    <MudAutocomplete T="ProductDto" @bind-Value="_product" SearchFunc="SearchProductsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : $"{p.Name} ({p.Sku})")"
                                     Label="Produkt (nazwa lub SKU)" DebounceInterval="300" MinCharacters="1" ResetValueOnEmptyText="true">
                        <ItemTemplate Context="p">
                            <div class="d-flex justify-space-between" style="width:100%">
                                <span>@p.Name <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">@p.Sku</MudText></span>
                                <span>@Labels.Money(p.Price) · <b>@p.StockQuantity</b> szt.</span>
                            </div>
                        </ItemTemplate>
                    </MudAutocomplete>
                </div>
                <MudNumericField @bind-Value="_quantity" Label="Ilość" Min="1" Max="10000" Style="width: 110px" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine" Disabled="_product is null">Dodaj</MudButton>
            </div>

            @if (_lines.Count > 0)
            {
                <MudSimpleTable Dense="true" Class="mt-4">
                    <thead>
                        <tr><th>Produkt</th><th class="d-none d-sm-table-cell" style="text-align:right">Cena</th><th style="width:130px">Ilość</th><th class="d-none d-sm-table-cell" style="text-align:right">Wartość</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _lines)
                        {
                            <tr>
                                <td>
                                    @if (line.Product is { } product)
                                    {
                                        <span>@product.Name <MudText Typo="Typo.caption" Class="mud-text-secondary" Inline="true">@product.Sku</MudText></span>
                                        @if (line.FromAssistant)
                                        {
                                            <AiChip Uncertain="line.Uncertain" UncertainText="@($"Niepewne dopasowanie do „{line.SpokenText}” – sprawdź.")" />
                                        }
                                    }
                                    else if (line.Candidates.Count > 0)
                                    {
                                        <MudSelect T="ProductCandidateDto" Value="null" ValueChanged="c => ChooseCandidate(line, c)" Dense="true" Error="true"
                                                   Label="@($"Wybierz produkt dla „{line.SpokenText}”")" ErrorText="Kilka produktów pasuje – wybierz właściwy"
                                                   ToStringFunc="@(c => c is null ? string.Empty : $"{c.Name} ({c.Sku})")">
                                            @foreach (var candidate in line.Candidates)
                                            {
                                                <MudSelectItem Value="candidate">@candidate.Name (@candidate.Sku) – @Labels.Money(candidate.Price), @candidate.Stock szt.</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        <MudAutocomplete T="ProductDto" Value="null" ValueChanged="p => ChooseProduct(line, p)" SearchFunc="SearchProductsAsync"
                                                         ToStringFunc="@(p => p is null ? string.Empty : $"{p.Name} ({p.Sku})")" Error="true"
                                                         Label="@($"Nie znaleziono „{line.SpokenText}” – wyszukaj produkt")" ErrorText="Wybierz produkt"
                                                         DebounceInterval="300" MinCharacters="1" Dense="true" />
                                    }
                                    @if (line.Product is not null)
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block d-sm-none mud-text-secondary">
                                            @Labels.Money(line.Product.Price) · razem <b>@Labels.Money(line.Product.Price * line.Quantity)</b>
                                        </MudText>
                                    }
                                </td>
                                <td class="d-none d-sm-table-cell" style="text-align:right">@(line.Product is null ? "—" : Labels.Money(line.Product.Price))</td>
                                <td>
                                    <MudNumericField @bind-Value="line.Quantity" Min="1" Max="10000" Variant="Variant.Text" Margin="Margin.Dense"
                                                     Error="@(line.Product is not null && line.Quantity > line.Product.Stock)" ErrorText="@($"Dostępne: {line.Product?.Stock}")" />
                                </td>
                                <td class="d-none d-sm-table-cell" style="text-align:right">@(line.Product is null ? "—" : Labels.Money(line.Product.Price * line.Quantity))</td>
                                <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _lines.Remove(line)" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            <div class="d-flex align-start mt-4">
                <MudTextField @bind-Value="_notes" Label="Uwagi do zamówienia (opcjonalnie)" Lines="2" MaxLength="1000" Class="flex-grow-1" />
                @if (_aiNotes)
                {
                    <AiChip />
                }
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudPaper Class="pa-4" Elevation="2" Style="position: sticky; top: 80px;">
            <MudText Typo="Typo.h6">Podsumowanie</MudText>
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.body2">Klient: <b>@ClientLabel</b></MudText>
            <MudText Typo="Typo.body2">Pozycji: <b>@_lines.Count</b></MudText>
            @if (_newClientMode || UsesNewAddress)
            {
                <div class="d-flex flex-wrap gap-1 mt-2">
                    @if (_newClientMode)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.PersonAdd">Zostanie utworzony nowy klient</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.AddLocationAlt">Nowy adres dostawy</MudChip>
                </div>
            }
            <MudText Typo="Typo.h5" Class="mt-3">@Labels.Money(EstimatedTotal)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Kwota orientacyjna – ostateczną sumę liczy serwer według aktualnych cen@(UseLocalData ? " przy wysyłce" : string.Empty).
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-4"
                       Disabled="!CanSubmit || _busy" OnClick="SubmitAsync"
                       StartIcon="@(UseLocalData ? Icons.Material.Filled.Schedule : Icons.Material.Filled.Check)">
                @SubmitLabel
            </MudButton>
            @if (!CanSubmit && MissingSteps.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">Uzupełnij: @string.Join(", ", MissingSteps).</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    /// <summary>Radio value for "new shipping address" next to the client's existing addresses.</summary>
    private static readonly Guid? NewAddressOption = Guid.Empty;

    private readonly List<OrderLine> _lines = [];
    private ClientSummaryDto? _client;
    private ClientDto? _clientDetails;
    private Guid? _addressId;
    private ProductDto? _product;
    private int _quantity = 1;
    private string? _notes;
    private bool _busy;

    private bool _newClientMode;
    private NewClientModel _newClient = new();
    private AddressModel _newAddress = new();
    private MapMarker? _newAddressPin;

    // What the assistant filled in (cleared when the admin changes it by hand).
    private IReadOnlyList<DraftWarningDto> _warnings = [];
    private IReadOnlyList<ClientCandidateDto> _clientCandidates = [];
    private bool _draftHasNewAddress;
    private bool _aiClient;
    private bool _clientUncertain;
    private bool _aiAddress;
    private bool _aiNotes;

    // Sent with the creates, so a repeated submit (or the outbox finishing it later) never creates anything twice.
    private Guid _orderRequestId = Guid.CreateVersion7();
    private Guid _clientRequestId = Guid.CreateVersion7();
    private Guid _addressRequestId = Guid.CreateVersion7();

    // Registered by the phone app only.
    private OfflineLookup? _lookup;
    private OrderOutbox? _outbox;

    [Parameter] public Guid? PreselectedClientId { get; set; }

    /// <summary>Called with the placed order; the host page decides where to go next.</summary>
    [Parameter] public EventCallback<OrderDto> OnPlaced { get; set; }

    /// <summary>The host lets the form keep the order on the device when the connection is poor or lost.</summary>
    [Parameter] public bool AllowQueue { get; set; }

    /// <summary>Called with the order kept on the device instead of being placed.</summary>
    [Parameter] public EventCallback<OutboxEntry> OnQueued { get; set; }

    /// <summary>A queued order to edit (e.g. refused by the server); submitting replaces it or places it.</summary>
    [Parameter] public OutboxEntry? Resume { get; set; }

    private bool CanQueue => AllowQueue && _outbox is not null;

    private bool HasLocalData => _lookup?.Products is not null && _lookup.Clients is not null;

    private bool UseLocalData => CanQueue && HasLocalData && Monitor.Quality != ConnectionQuality.Good;

    private bool LocalDataMissing => CanQueue && !HasLocalData && Monitor.Quality != ConnectionQuality.Good;

    private string LocalDataTime => _lookup?.CheckedAt is { } at ? Labels.Time(at) : "—";

    private IReadOnlyList<AddressDto> ShippingAddresses =>
        _clientDetails?.Addresses.Where(a => a.Type == AddressType.Shipping).ToList() ?? [];

    private bool UsesNewAddress => _newClientMode || (_clientDetails is not null && _addressId == NewAddressOption);

    private IReadOnlyList<ClientCandidateDto> OtherCandidates => _clientCandidates.Where(c => c.Id != _client?.Id || _newClientMode).ToList();

    private string CandidatesTitle =>
        _newClientMode ? "Czy chodziło o istniejącego klienta?"
        : _client is null ? "Pasuje kilku klientów – wybierz właściwego:"
        : "Inni podobni klienci:";

    private string ClientLabel =>
        _newClientMode ? (string.IsNullOrWhiteSpace(_newClient.Name + _newClient.Surname) ? "nowy klient" : $"{_newClient.Name} {_newClient.Surname}")
        : _client is null ? "—" : $"{_client.Name} {_client.Surname}";

    private decimal EstimatedTotal => _lines.Where(l => l.Product is not null).Sum(l => l.Product!.Price * l.Quantity);

    private bool ClientReady => _newClientMode ? _newClient.IsValid : _client is not null;

    private bool AddressReady => UsesNewAddress ? _newAddress.IsComplete : _addressId is not null;

    private bool LinesReady => _lines.Count > 0 && _lines.All(l => l.Product is not null && l.Quantity > 0);

    private bool CanSubmit => ClientReady && AddressReady && LinesReady;

    private IReadOnlyList<string> MissingSteps =>
    [
        .. ClientReady ? Array.Empty<string>() : ["dane klienta"],
        .. AddressReady ? Array.Empty<string>() : ["adres dostawy"],
        .. LinesReady ? Array.Empty<string>() : ["produkty"],
    ];

    private string SubmitLabel =>
        UseLocalData ? "Zapisz do wysłania"
        : _newClientMode ? "Utwórz klienta i złóż zamówienie"
        : UsesNewAddress ? "Dodaj adres i złóż zamówienie"
        : "Złóż zamówienie";

    private RenderFragment NewAddressForm => @<div class="mt-2">
        <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.AddLocationAlt" Class="mb-2">
            Nowy adres dostawy – zostanie dodany do klienta przy składaniu zamówienia.
        </MudAlert>
        <MudGrid Spacing="2">
            <AddressFields Model="_newAddress" ShowType="false" HighlightMissing="true" Immediate="true" Changed="OnFormChanged" />
        </MudGrid>
        @if (_newAddressPin is not null)
        {
            <div class="mt-3">
                <LeafletMap Markers="[_newAddressPin]" Height="220px" Zoom="15" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Podgląd położenia znalezionego dla podanego adresu – dokładne współrzędne zostaną ustalone przy zapisie.
                </MudText>
            </div>
        }
    </div>;

    protected override async Task OnInitializedAsync()
    {
        _lookup = Services.GetService<OfflineLookup>();
        _outbox = Services.GetService<OrderOutbox>();
        Monitor.QualityChanged += OnQualityChanged;
        if (_lookup is not null)
        {
            _lookup.Changed += OnLookupChanged;
        }

        if (Resume is { } entry)
        {
            ApplyEntry(entry);
        }
        else if (PreselectedClientId is { } clientId)
        {
            await LoadClientAsync(clientId);
        }
    }

    public void Dispose()
    {
        Monitor.QualityChanged -= OnQualityChanged;
        if (_lookup is not null)
        {
            _lookup.Changed -= OnLookupChanged;
        }
    }

    private void OnQualityChanged(ConnectionQuality quality) => InvokeAsync(StateHasChanged);

    private void OnLookupChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Re-renders the page (summary, submit button) after a child form changed its model.</summary>
    private static void OnFormChanged()
    {
    }

    private async Task<IEnumerable<ClientSummaryDto>> SearchClientsAsync(string? text, CancellationToken cancellationToken)
    {
        if (UseLocalData)
        {
            return [.. LocalSearch.Clients(_lookup!.Clients!.Items, text).Take(10).Select(ToSummary)];
        }

        var result = await Api.GetAsync<PagedResult<ClientSummaryDto>>(
            $"api/clients{QueryString.Build(("search", text), ("isActive", true), ("pageSize", 10))}", cancellationToken);
        return result.IsSuccess ? result.Value.Items : [];
    }

    private async Task<IEnumerable<ProductDto>> SearchProductsAsync(string? text, CancellationToken cancellationToken)
    {
        if (UseLocalData)
        {
            return [.. LocalSearch.Products(_lookup!.Products!.Items, text).Take(15)
                .Select(p => new ProductDto(p.Id, p.Name, null, p.Sku, p.Price, p.StockQuantity, true, default, p.Categories))];
        }

        var result = await Api.GetAsync<PagedResult<ProductDto>>(
            $"api/products{QueryString.Build(("search", text), ("isActive", true), ("pageSize", 15))}", cancellationToken);
        return result.IsSuccess ? result.Value.Items : [];
    }

    private async Task OnClientSelectedAsync(ClientSummaryDto? client)
    {
        _client = client;
        _clientDetails = null;
        _addressId = null;
        _aiClient = false;
        if (client is not null)
        {
            await LoadClientAsync(client.Id);
        }
    }

    private async Task LoadClientAsync(Guid clientId)
    {
        if (UseLocalData)
        {
            if (_lookup!.Clients!.Items.FirstOrDefault(c => c.Id == clientId) is { } local)
            {
                _client = ToSummary(local);
                SetClientDetails(ToDetails(local));
            }
            else
            {
                Snackbar.Add("Tego klienta nie ma w danych zapisanych w telefonie.", Severity.Warning);
            }

            return;
        }

        var result = await Api.GetAsync<ClientDto>($"api/clients/{clientId}");
        if (Snackbar.Report(result))
        {
            var c = result.Value;
            _client = new ClientSummaryDto(c.Id, c.Username, c.Email, c.Name, c.Surname, c.PhoneNumber, c.IsActive, c.Addresses.Count, c.CreatedAt);
            SetClientDetails(c);
        }
    }

    private void SetClientDetails(ClientDto client)
    {
        _clientDetails = client;
        var shipping = client.Addresses.Where(a => a.Type == AddressType.Shipping).ToList();
        _addressId = shipping.Count switch
        {
            0 => NewAddressOption,
            1 => shipping[0].Id,
            _ => null,
        };
    }

    /// <summary>Fills the whole form from an assistant draft; the worker reviews it and places the order.</summary>
    private async Task ApplyDraftAsync(OrderDraftDto draft)
    {
        _warnings = draft.Warnings;
        _clientCandidates = draft.Client.Candidates;
        _aiClient = true;
        _clientUncertain = draft.Client.Mode == DraftClientMode.Ambiguous;
        _newClient = draft.Client.NewClient is { } newClient ? NewClientModel.From(newClient) : new NewClientModel();
        _client = null;
        _clientDetails = null;
        _addressId = null;

        // Address first, so choosing a client below can fall back to the drafted new address.
        _draftHasNewAddress = draft.Address.NewAddress is not null;
        _newAddress = draft.Address.NewAddress is { } address ? AddressModel.From(address) : new AddressModel();
        _newAddressPin = draft.Address.NewAddress is { Latitude: { } lat, Longitude: { } lng }
            ? new MapMarker(lat, lng, "Nowy adres", MapMarkerKind.Pin)
            : null;
        _aiAddress = draft.Address.Mode != DraftAddressMode.None;

        _newClientMode = draft.Client.Mode == DraftClientMode.New;
        if (draft.Client is { Mode: DraftClientMode.Existing, SelectedId: { } clientId })
        {
            var match = draft.Client.Candidates.First(c => c.Id == clientId);
            _clientUncertain = match.Reason == ClientMatchReason.Name && match.Score < 0.97;
            await LoadClientAsync(clientId);
            ApplyDraftAddress(draft.Address.SelectedId);
        }

        _lines.Clear();
        foreach (var line in draft.Lines)
        {
            var selected = line.Candidates.FirstOrDefault(c => c.Id == line.SelectedProductId);
            _lines.Add(new OrderLine
            {
                Product = selected is null ? null : LineProduct.From(selected),
                Quantity = line.Quantity,
                SpokenText = line.SpokenText,
                Candidates = line.Candidates,
                Score = selected?.Score,
            });
        }

        _aiNotes = draft.Notes is not null;
        if (draft.Notes is not null)
        {
            _notes = draft.Notes;
        }
    }

    /// <summary>After a client is chosen: the matched existing address, else the drafted new one.</summary>
    private void ApplyDraftAddress(Guid? matchedAddressId)
    {
        if (_clientDetails is null)
        {
            return;
        }

        if (matchedAddressId is not null)
        {
            _addressId = matchedAddressId;
        }
        else if (_draftHasNewAddress)
        {
            _addressId = NewAddressOption;
        }
    }

    private async Task SelectCandidateAsync(ClientCandidateDto candidate)
    {
        _newClientMode = false;
        _clientUncertain = false;
        await LoadClientAsync(candidate.Id);
        ApplyDraftAddress(candidate.MatchedAddressId);
    }

    private void AddLine()
    {
        if (_product is null)
        {
            return;
        }

        var existing = _lines.FirstOrDefault(l => l.Product?.Id == _product.Id);
        if (existing is not null)
        {
            existing.Quantity += _quantity;
        }
        else
        {
            _lines.Add(new OrderLine { Product = LineProduct.From(_product), Quantity = _quantity });
        }

        _product = null;
        _quantity = 1;
    }

    private static void ChooseCandidate(OrderLine line, ProductCandidateDto? candidate)
    {
        if (candidate is not null)
        {
            line.Product = LineProduct.From(candidate);
            line.Score = null;
        }
    }

    private static void ChooseProduct(OrderLine line, ProductDto? product)
    {
        if (product is not null)
        {
            line.Product = LineProduct.From(product);
            line.Score = null;
        }
    }

    /// <summary>
    /// Accept flow: create the client (with the address) or add the address, then place the order – each step through
    /// the regular validated endpoints, each with its request id. Created records switch the form to "existing", and a
    /// repeated step returns what the first one created, so a retry after a failed order never creates duplicates.
    /// Without a good connection (or when it breaks on the way) the order goes to the outbox instead, where allowed.
    /// </summary>
    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            if (UseLocalData)
            {
                await QueueAsync();
                return;
            }

            if (_newClientMode)
            {
                var created = await Api.PostAsync<ClientDto>("api/clients", NewClientRequest());
                if (await QueueOnConnectionLossAsync(created) || !Snackbar.Report(created))
                {
                    return;
                }

                AdoptCreatedClient(created.Value);
                Snackbar.Add($"Utworzono klienta {created.Value.Name} {created.Value.Surname}.", Severity.Info);
            }
            else if (UsesNewAddress)
            {
                var added = await Api.PostAsync<AddressDto>($"api/clients/{_client!.Id}/addresses", NewAddressRequest());
                if (await QueueOnConnectionLossAsync(added) || !Snackbar.Report(added, "Dodano adres dostawy."))
                {
                    return;
                }

                _clientDetails = _clientDetails! with { Addresses = [.. _clientDetails.Addresses, added.Value] };
                _addressId = added.Value.Id;
            }

            var request = new PlaceOrderRequest(
                _client!.Id,
                _addressId!.Value,
                [.. _lines.GroupBy(l => l.Product!.Id).Select(g => new OrderLineRequest(g.Key, g.Sum(l => l.Quantity)))],
                _notes,
                _orderRequestId);
            var result = await Api.PostAsync<OrderDto>("api/orders", request);
            if (await QueueOnConnectionLossAsync(result))
            {
                return;
            }

            if (Snackbar.Report(result, $"Zamówienie #{(result.IsSuccess ? result.Value.Number : 0)} zostało złożone."))
            {
                if (Resume is not null)
                {
                    await _outbox!.DiscardAsync(Resume.Id);
                }

                await OnPlaced.InvokeAsync(result.Value);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private CreateClientRequest NewClientRequest() => _newClient.ToRequest(_newAddress.ToRequest()) with { RequestId = _clientRequestId };

    private AddressRequest NewAddressRequest() => _newAddress.ToRequest() with { RequestId = _addressRequestId };

    /// <summary>The connection broke during an online submit: the order goes to the outbox with the same request ids.</summary>
    private async Task<bool> QueueOnConnectionLossAsync(ApiResult result)
    {
        if (result.IsSuccess || !CanQueue || !OrderOutbox.IsTransient(result.Problem!))
        {
            return false;
        }

        await QueueAsync();
        return true;
    }

    private async Task QueueAsync()
    {
        var entry = BuildEntry();
        if (Resume is not null)
        {
            await _outbox!.UpdateAsync(entry);
        }
        else
        {
            await _outbox!.EnqueueAsync(entry);
        }

        await OnQueued.InvokeAsync(entry);
    }

    /// <summary>What the outbox needs to finish the order later: the remaining steps, their request ids and what to show.</summary>
    private OutboxEntry BuildEntry()
    {
        List<OutboxLine> lines =
        [
            .. _lines.GroupBy(l => l.Product!.Id).Select(g =>
            {
                var product = g.First().Product!;
                return new OutboxLine(product.Id, product.Sku, product.Name, g.Sum(l => l.Quantity), product.Price);
            }),
        ];
        var createdAt = Resume?.CreatedAt ?? Clock.GetUtcNow();

        if (_newClientMode)
        {
            var client = NewClientRequest();
            return new OutboxEntry(
                _orderRequestId, createdAt, OutboxStatus.Pending, client, null, null, null,
                new ClientLookupDto(Guid.Empty, client.Username, client.Email, client.Name, client.Surname, client.PhoneNumber, []),
                Labels.Format(client.Addresses![0]), lines, _notes);
        }

        var details = _clientDetails!;
        var snapshot = new ClientLookupDto(details.Id, details.Username, details.Email, details.Name, details.Surname, details.PhoneNumber, ShippingAddresses);
        if (UsesNewAddress)
        {
            var address = NewAddressRequest();
            return new OutboxEntry(
                _orderRequestId, createdAt, OutboxStatus.Pending, null, details.Id, address, null, snapshot, Labels.Format(address), lines, _notes);
        }

        return new OutboxEntry(
            _orderRequestId, createdAt, OutboxStatus.Pending, null, details.Id, null, _addressId, snapshot,
            Labels.Format(ShippingAddresses.Single(a => a.Id == _addressId)), lines, _notes);
    }

    /// <summary>Fills the form from a queued order; current prices and stock come from the device's copy where it has them.</summary>
    private void ApplyEntry(OutboxEntry entry)
    {
        _orderRequestId = entry.Id;
        _notes = entry.Notes;

        if (entry.ClientId is { } clientId)
        {
            // The entry may know an address the outbox created meanwhile that the device's copy does not have yet.
            var current = _lookup?.Clients?.Items.FirstOrDefault(c => c.Id == clientId) ?? entry.Client;
            current = current with { ShippingAddresses = [.. current.ShippingAddresses.UnionBy(entry.Client.ShippingAddresses, a => a.Id)] };
            _client = ToSummary(current);
            SetClientDetails(ToDetails(current));
            if (entry.AddressId is { } addressId)
            {
                _addressId = addressId;
            }
            else if (entry.NewAddress is { } address)
            {
                _addressId = NewAddressOption;
                _newAddress = AddressModel.From(address);
                _addressRequestId = address.RequestId ?? _addressRequestId;
            }
        }
        else if (entry.NewClient is { } newClient)
        {
            _newClientMode = true;
            _newClient = NewClientModel.From(newClient);
            _newAddress = AddressModel.From(newClient.Addresses![0]);
            _clientRequestId = newClient.RequestId ?? _clientRequestId;
        }

        _lines.Clear();
        foreach (var line in entry.Lines)
        {
            // A product no longer on the device (deactivated) keeps its old price and shows no stock.
            var product = _lookup?.Products?.Items.FirstOrDefault(p => p.Id == line.ProductId);
            _lines.Add(new OrderLine
            {
                Product = product is null
                    ? new LineProduct(line.ProductId, line.Name, line.Sku, line.UnitPrice, 0)
                    : new LineProduct(product.Id, product.Name, product.Sku, product.Price, product.StockQuantity),
                Quantity = line.Quantity,
            });
        }
    }

    private static ClientSummaryDto ToSummary(ClientLookupDto c) =>
        new(c.Id, c.Username, c.Email, c.Name, c.Surname, c.PhoneNumber, true, c.ShippingAddresses.Count, default);

    private static ClientDto ToDetails(ClientLookupDto c) =>
        new(c.Id, c.Username, c.Email, c.Name, c.Surname, c.PhoneNumber, true, default, c.ShippingAddresses);

    private void AdoptCreatedClient(ClientDto client)
    {
        _newClientMode = false;
        _clientCandidates = [];
        _client = new ClientSummaryDto(client.Id, client.Username, client.Email, client.Name, client.Surname, client.PhoneNumber, client.IsActive, client.Addresses.Count, client.CreatedAt);
        _clientDetails = client;
        _addressId = client.Addresses.Single(a => a.Type == AddressType.Shipping).Id;
    }

    private sealed record LineProduct(Guid Id, string Name, string Sku, decimal Price, int Stock)
    {
        public static LineProduct From(ProductDto p) => new(p.Id, p.Name, p.Sku, p.Price, p.StockQuantity);

        public static LineProduct From(ProductCandidateDto p) => new(p.Id, p.Name, p.Sku, p.Price, p.Stock);
    }

    private sealed class OrderLine
    {
        public LineProduct? Product { get; set; }

        public int Quantity { get; set; } = 1;

        /// <summary>What was said, for lines filled in by the assistant.</summary>
        public string? SpokenText { get; init; }

        public IReadOnlyList<ProductCandidateDto> Candidates { get; init; } = [];

        /// <summary>Match score of an automatically selected product; <c>null</c> once the admin chose it.</summary>
        public double? Score { get; set; }

        public bool FromAssistant => SpokenText is not null;

        public bool Uncertain => Score is < 0.95;
    }
}
