@* Order assistant: dictation or typing → editable text → draft (nothing is saved). Hidden when no assistant is available.
   In the phone app it is the server's assistant or, with a poor connection, the model on the phone (chip + choice). *@
@using Kamada.Web.Shared.Assistant
@using Kamada.Web.Shared.Audio
@using Kamada.Web.Shared.Connectivity
@using Kamada.Web.Shared.Offline
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IOrderAssistant Assistant
@inject IServiceProvider Services
@inject ConnectionMonitor Monitor
@inject ISnackbar Snackbar

@if (_status?.Enabled == true)
{
    <MudPaper Class="pa-4 mb-4 kamada-assistant" Elevation="1">
        <div class="d-flex flex-wrap align-center gap-2 mb-1">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Info" />
            <MudText Typo="Typo.h6">Asystent</MudText>
            @if (_routing is not null && _settings is not null)
            {
                <MudMenu>
                    <ActivatorContent>
                        <MudChip T="string" Size="Size.Small" Color="@(OnDevice ? Color.Success : Color.Default)" Variant="Variant.Outlined"
                                 Icon="@(OnDevice ? Icons.Material.Filled.PhoneAndroid : Icons.Material.Filled.Cloud)"
                                 OnClick="@context.ToggleAsync" Class="ma-0">
                            @(OnDevice ? "Asystent w telefonie" : "Asystent na serwerze")
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="() => SetModeAsync(AssistantMode.Auto)">Automatycznie (serwer, a w telefonie przy słabym połączeniu)</MudMenuItem>
                        <MudMenuItem OnClick="() => SetModeAsync(AssistantMode.Server)">Zawsze serwer</MudMenuItem>
                        <MudMenuItem OnClick="() => SetModeAsync(AssistantMode.Device)" Disabled="!_routing.DeviceReady">Zawsze telefon (dane nie opuszczają urządzenia)</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@(OnDevice ? "Model w telefonie" : "Lokalny model"): @_status.Model</MudText>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Podyktuj albo wpisz zamówienie własnymi słowami (po polsku lub angielsku). Asystent wypełni formularz – nic nie
            zostanie zapisane, dopóki nie sprawdzisz danych i nie złożysz zamówienia.
        </MudText>

        <VoiceRecorder @bind-Language="_language" Available="_status.SpeechToText" Disabled="_busy" OnRecorded="TranscribeAsync"
                       UnavailableText="Model rozpoznawania mowy jest jeszcze pobierany lub wyłączony – możesz wpisać tekst." />

        <MudTextField @bind-Value="_text" Lines="3" Variant="Variant.Outlined" Immediate="true" MaxLength="MaxLength" Counter="MaxLength"
                      Label="Treść zamówienia" Disabled="_busy" Class="mt-3" HelperText="@_transcriptHint"
                      Placeholder="np. Nowe zamówienie dla Jana Kowalskiego, Grunwaldzka 15 mieszkania 4 w Gdańsku, telefon 600 100 200: sześć wód niegazowanych półtora litra i dwa chleby razowe" />

        <div class="d-flex align-center mt-2">
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="FillAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_text))"
                       StartIcon="@Icons.Material.Filled.AutoAwesome">
                Wypełnij formularz
            </MudButton>
        </div>

        @if (_busy)
        {
            <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="mt-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_busyText</MudText>
        }
    </MudPaper>
}

@code {
    private const int MaxLength = 2000;
    private static readonly TimeSpan StatusRefresh = TimeSpan.FromSeconds(15);

    private readonly CancellationTokenSource _disposed = new();
    private AssistantStatusDto? _status;
    private RoutingOrderAssistant? _routing;
    private LocalAssistantSettings? _settings;
    private OfflineLookup? _lookup;
    private string _text = string.Empty;
    private string _language = "auto";
    private string? _transcriptHint;
    private bool _busy;
    private string _busyText = string.Empty;

    /// <summary>Raised with the draft the form should be filled with.</summary>
    [Parameter] public EventCallback<OrderDraftDto> OnDraft { get; set; }

    private bool OnDevice => _routing?.Location == AssistantLocation.Device;

    protected override async Task OnInitializedAsync()
    {
        // Only the phone app has the routing assistant (server or device); the web panel always uses the server.
        _routing = Services.GetService<RoutingOrderAssistant>();
        _settings = Services.GetService<LocalAssistantSettings>();
        _lookup = Services.GetService<OfflineLookup>();
        Monitor.QualityChanged += OnQualityChanged;
        if (_lookup is not null)
        {
            _lookup.Changed += OnLookupChanged;
        }

        if (_routing is not null)
        {
            _routing.LocationChanged += OnLocationChanged;
        }

        await LoadStatusAsync();
        _ = RefreshUntilSpeechIsReadyAsync(_disposed.Token);
    }

    private async Task LoadStatusAsync()
    {
        _status = await Assistant.GetStatusAsync();
    }

    private async Task SetModeAsync(AssistantMode mode)
    {
        await _settings!.SetModeAsync(mode);
        await LoadStatusAsync();
    }

    private void OnQualityChanged(ConnectionQuality quality) => InvokeAsync(async () =>
    {
        // A different connection can mean a different assistant (and the other one's speech model state).
        await LoadStatusAsync();
        StateHasChanged();
    });

    private void OnLocationChanged() => InvokeAsync(StateHasChanged);

    /// <summary>The phone's copy of clients and products arrives (or is wiped) after the panel was created: the on-device assistant depends on it.</summary>
    private void OnLookupChanged() => InvokeAsync(async () =>
    {
        await LoadStatusAsync();
        StateHasChanged();
    });

    /// <summary>The speech model is downloaded on the server's first start: enable dictation as soon as it is ready.</summary>
    private async Task RefreshUntilSpeechIsReadyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(StatusRefresh);
        try
        {
            while (_status is { Enabled: true, SpeechToText: false } && await timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadStatusAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task TranscribeAsync(RecordedAudio recording)
    {
        await RunAsync("Rozpoznaję mowę…", async () =>
        {
            var result = await Assistant.TranscribeAsync(recording);
            if (Snackbar.Report(result))
            {
                _text = result.Value.Text;
                _transcriptHint = $"Rozpoznany tekst ({result.Value.Language}) – popraw go w razie potrzeby i kliknij „Wypełnij formularz”.";
            }
        });
    }

    private async Task FillAsync()
    {
        await RunAsync(OnDevice
            ? "Model działa w telefonie – pierwsze uruchomienie (ładowanie modelu) trwa dłużej, potem kilkanaście sekund."
            : "Model działa lokalnie – bez karty graficznej może to potrwać kilkanaście sekund.", async () =>
        {
            var result = await Assistant.CreateDraftAsync(_text.Trim(), _language);
            if (Snackbar.Report(result))
            {
                await OnDraft.InvokeAsync(result.Value);
            }
        });
    }

    private async Task RunAsync(string busyText, Func<Task> action)
    {
        (_busy, _busyText) = (true, busyText);
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        Monitor.QualityChanged -= OnQualityChanged;
        if (_lookup is not null)
        {
            _lookup.Changed -= OnLookupChanged;
        }

        if (_routing is not null)
        {
            _routing.LocationChanged -= OnLocationChanged;
        }

        _disposed.Cancel();
        _disposed.Dispose();
    }
}
