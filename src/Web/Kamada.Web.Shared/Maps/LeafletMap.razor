@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_elementId" class="kamada-map" style="height:@Height; width:100%; border-radius:8px; z-index:0;"></div>

@code {
    private readonly string _elementId = $"map-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<LeafletMap>? _selfReference;
    private string? _renderedSignature;

    [Parameter] public IReadOnlyList<MapMarker> Markers { get; set; } = [];

    /// <summary>Polyline through the points in order (delivery route).</summary>
    [Parameter] public IReadOnlyList<MapPoint>? Route { get; set; }

    [Parameter] public MapPoint? Center { get; set; }

    [Parameter] public int Zoom { get; set; } = 13;

    [Parameter] public string Height { get; set; } = "320px";

    /// <summary>When set, clicking the map reports the clicked point (manual pin placement).</summary>
    [Parameter] public EventCallback<MapPoint> OnMapClick { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Kamada.Web.Shared/leaflet-map.js");
                _selfReference = DotNetObjectReference.Create(this);
                var center = Center ?? FirstMarker() ?? MapPoint.DefaultCenter;
                await _module.InvokeVoidAsync("create", _elementId, _selfReference, center, Zoom, OnMapClick.HasDelegate);
            }

            // Re-draw (and re-fit the view) only when the data changed, not on every parent render.
            var signature = Signature();
            if (_module is not null && signature != _renderedSignature)
            {
                _renderedSignature = signature;
                await _module.InvokeVoidAsync("update", _elementId, Markers.Select(ToJs), Route, true);
            }
        }
        catch (JSException)
        {
            // Map tiles/library unavailable (offline): the rest of the page keeps working.
        }
    }

    [JSInvokable]
    public Task OnMapClicked(double latitude, double longitude) => OnMapClick.InvokeAsync(new MapPoint(latitude, longitude));

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _elementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }

    private string Signature() =>
        string.Join('|', Markers.Select(m => $"{m.Latitude:F6},{m.Longitude:F6},{m.Kind},{m.Number},{m.Label}"))
        + "#" + string.Join('|', (Route ?? []).Select(p => $"{p.Latitude:F6},{p.Longitude:F6}"));

    private MapPoint? FirstMarker() => Markers.Count > 0 ? new MapPoint(Markers[0].Latitude, Markers[0].Longitude) : null;

    private static object ToJs(MapMarker marker) => new
    {
        latitude = marker.Latitude,
        longitude = marker.Longitude,
        label = marker.Label,
        number = marker.Number,
        kind = marker.Kind.ToString().ToLowerInvariant(),
    };
}
