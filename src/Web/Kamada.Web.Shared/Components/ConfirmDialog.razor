<MudDialog>
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Anuluj</MudButton>
        <MudButton Color="@ConfirmColor" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(true))">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string Message { get; set; } = string.Empty;

    [Parameter] public string ConfirmText { get; set; } = "Potwierdź";

    [Parameter] public Color ConfirmColor { get; set; } = Color.Primary;
}
