@page "/account/password"
@attribute [Authorize]
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* Shared by the web panel and the phone app; no role in [Authorize], so every role of the phone app shows it. *@
<PageTitle>Zmień hasło – KAMADA</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Zmień hasło</MudText>

<MudPaper Class="pa-4" Style="max-width: 480px">
    <MudForm @ref="_form" @bind-IsValid="_valid">
        <MudTextField @bind-Value="_current" Label="Obecne hasło" Required="true" RequiredError="Podaj obecne hasło."
                      InputType="InputType.Password" MaxLength="128" Class="mb-2"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "current-password" })" />
        <MudTextField @bind-Value="_new" Label="Nowe hasło" Required="true" RequiredError="Podaj nowe hasło."
                      InputType="InputType.Password" MaxLength="128" HelperText="@PasswordRules.Hint" Class="mb-2"
                      Validation="@(new Func<string, string?>(ValidateNew))"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
        <MudTextField @bind-Value="_repeat" Label="Powtórz nowe hasło" Required="true" RequiredError="Powtórz nowe hasło."
                      InputType="InputType.Password" MaxLength="128"
                      Validation="@(new Func<string, string?>(ValidateRepeat))"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
    </MudForm>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
        Po zmianie hasła pozostałe urządzenia zostaną wylogowane. To urządzenie pozostanie zalogowane.
    </MudText>
    <div class="d-flex justify-end gap-2 mt-4">
        <MudButton OnClick="Back" Disabled="_busy">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Zmień hasło</MudButton>
    </div>
</MudPaper>

@code {
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _repeat = string.Empty;

    private string? ValidateNew(string? value) =>
        PasswordRules.Validate(value) ?? (value == _current && !string.IsNullOrEmpty(value) ? "Nowe hasło musi różnić się od obecnego." : null);

    private string? ValidateRepeat(string? value) => value == _new ? null : "Hasła nie są takie same.";

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_valid)
        {
            return;
        }

        _busy = true;
        var result = await Auth.ChangePasswordAsync(_current, _new);
        _busy = false;

        if (Snackbar.Report(result, "Hasło zostało zmienione. Pozostałe urządzenia zostały wylogowane."))
        {
            Back();
        }
    }

    private void Back() => Navigation.NavigateTo("");
}
