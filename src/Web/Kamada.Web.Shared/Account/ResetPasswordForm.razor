@inject AuthService Auth

@* Card of the page the reset e-mail links to (the web panel hosts it). *@
<MudPaper Elevation="8" Class="pa-8" Style="width: 100%; max-width: 420px;">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Ustaw nowe hasło</MudText>

    @if (string.IsNullOrEmpty(Token))
    {
        <MudAlert Severity="Severity.Warning">
            Brak kodu w linku. Otwórz link z wiadomości e-mail w całości albo poproś o nowy.
        </MudAlert>
        <MudLink Href="forgot-password" Typo="Typo.body2" Class="d-block mt-6">Poproś o nowy link</MudLink>
    }
    else if (_done)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            Hasło zostało zmienione. Zaloguj się nowym hasłem – na wszystkich urządzeniach trzeba zalogować się ponownie.
        </MudAlert>
        <MudButton Href="login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Przejdź do logowania</MudButton>
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_new" Label="Nowe hasło" Variant="Variant.Outlined" InputType="InputType.Password"
                          Required="true" RequiredError="Podaj nowe hasło." MaxLength="128" HelperText="@PasswordRules.Hint"
                          Validation="@(new Func<string, string?>(PasswordRules.Validate))" Class="mb-4"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
            <MudTextField @bind-Value="_repeat" Label="Powtórz nowe hasło" Variant="Variant.Outlined" InputType="InputType.Password"
                          Required="true" RequiredError="Powtórz nowe hasło." MaxLength="128"
                          Validation="@(new Func<string, string?>(ValidateRepeat))"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
        </MudForm>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_error</MudAlert>
            @if (_expired)
            {
                <MudLink Href="forgot-password" Typo="Typo.body2" Class="d-block mt-2">Poproś o nowy link</MudLink>
            }
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-6"
                   OnClick="SaveAsync" Disabled="_busy">Ustaw hasło</MudButton>
    }
</MudPaper>

@code {
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private bool _done;
    private bool _expired;
    private string? _error;
    private string _new = string.Empty;
    private string _repeat = string.Empty;

    /// <summary>The token from the link (<c>?token=</c>).</summary>
    [Parameter] public string? Token { get; set; }

    private string? ValidateRepeat(string? value) => value == _new ? null : "Hasła nie są takie same.";

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_valid)
        {
            return;
        }

        _busy = true;
        _error = null;
        var result = await Auth.ResetPasswordAsync(Token!, _new);
        _busy = false;

        if (result.IsSuccess)
        {
            _done = true;
        }
        else
        {
            _error = result.Problem!.Message;
            _expired = result.Problem.Code == "Auth.InvalidResetToken";
        }
    }
}
