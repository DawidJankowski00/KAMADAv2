@inject AuthService Auth

@* Card of the "forgot password" page; each app hosts it in its own login layout. *@
<MudPaper Elevation="8" Class="pa-8" Style="width: 100%; max-width: 420px;">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-2">Nie pamiętam hasła</MudText>

    @if (_sent)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            Jeśli do tego adresu jest przypisane konto, wysłaliśmy na niego link do ustawienia nowego hasła.
            Link działa jeden raz i wkrótce wygasa.
        </MudAlert>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
            Nie widzisz wiadomości? Sprawdź folder spam albo poproś administratora o ustawienie hasła.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Podaj adres e-mail przypisany do konta. Wyślemy na niego link do ustawienia nowego hasła.
        </MudText>
        <EditForm Model="_model" OnValidSubmit="SendAsync">
            <MudTextField @bind-Value="_model.Email" Label="E-mail" Variant="Variant.Outlined" InputType="InputType.Email"
                          Required="true" RequiredError="Podaj adres e-mail." MaxLength="254" AutoFocus="true"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "email" })" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Size="Size.Large" Class="mt-6" Disabled="_busy">Wyślij link</MudButton>
        </EditForm>
    }

    <MudLink Href="login" Typo="Typo.body2" Class="d-block mt-6">Wróć do logowania</MudLink>
</MudPaper>

@code {
    private readonly ForgotModel _model = new();
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SendAsync()
    {
        _busy = true;
        _error = null;
        var result = await Auth.RequestPasswordResetAsync(_model.Email.Trim());
        _busy = false;

        if (result.IsSuccess)
        {
            _sent = true;
        }
        else
        {
            _error = result.Problem!.Message;
        }
    }

    private sealed class ForgotModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
