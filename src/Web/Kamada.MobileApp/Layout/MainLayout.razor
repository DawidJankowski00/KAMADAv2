@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject RoleContext RoleContext
@inject NavigationManager Navigation

<MudThemeProvider Theme="MobileTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
            <MudText Typo="Typo.h6">KAMADA</MudText>
        </MudLink>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-1">
                    @context.User.FindFirst("given_name")?.Value @context.User.FindFirst("family_name")?.Value
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" aria-label="Wyloguj" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-4 px-3">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @if (!_rolesLoaded)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (PageRole is { } role && role != RoleContext.ActiveRole && RoleContext.AvailableRoles.Contains(role))
                    {
                        <SwitchRolePrompt Role="@role" />
                    }
                    else
                    {
                        @Body
                    }
                </ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        Wystąpił nieoczekiwany błąd.
                        <MudButton Size="Size.Small" OnClick="() => _errorBoundary?.Recover()">Spróbuj ponownie</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private ErrorBoundary? _errorBoundary;
    private bool _rolesLoaded;

    [CascadingParameter] public RouteData? RouteData { get; set; }

    /// <summary>
    /// The role whose area the current page belongs to. A page of a role the user has but is not working in shows a
    /// prompt to switch instead of the page; a role the user does not have is handled by <c>[Authorize]</c>.
    /// </summary>
    private string? PageRole => RouteData is null ? null : RoleAreas.RoleOf(RouteData.PageType);

    protected override void OnInitialized() => RoleContext.ActiveRoleChanged += OnActiveRoleChanged;

    protected override async Task OnParametersSetAsync()
    {
        await RoleContext.LoadAsync();
        _rolesLoaded = true;
    }

    public void Dispose() => RoleContext.ActiveRoleChanged -= OnActiveRoleChanged;

    private void OnActiveRoleChanged() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
