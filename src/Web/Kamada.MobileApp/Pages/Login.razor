@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Logowanie – KAMADA</PageTitle>

<MudPaper Elevation="8" Class="pa-8" Style="width: 100%; max-width: 420px;">
    <div class="d-flex align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Primary" Size="Size.Large" Class="mr-3" />
        <div>
            <MudText Typo="Typo.h5">KAMADA</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Aplikacja dla pracowników</MudText>
        </div>
    </div>

    <EditForm Model="_model" OnValidSubmit="SignInAsync">
        <MudTextField @bind-Value="_model.Username" Label="Login" Variant="Variant.Outlined" Class="mb-4"
                      Required="true" RequiredError="Podaj login." autocomplete="username" AutoFocus="true" />
        <MudTextField @bind-Value="_model.Password" Label="Hasło" Variant="Variant.Outlined" InputType="InputType.Password"
                      Required="true" RequiredError="Podaj hasło." autocomplete="current-password" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_error</MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   Size="Size.Large" Class="mt-6" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Zaloguj się
        </MudButton>
    </EditForm>

    <div class="mt-6">
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Konta demo:</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            Kurier: <b>kurier1</b>, <b>kurier2</b>, <b>kurier3</b> / <b>Kurier123!</b>
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            Administrator: <b>admin</b> / <b>Admin123!</b>
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            Sprzedawca: <b>sprzedawca1</b> / <b>Sprzedawca123!</b>
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            Wszystkie role: <b>kierownik</b> / <b>Kierownik123!</b>
        </MudText>
    </div>
</MudPaper>

@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private string? _error;

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.GetCurrentUserAsync() is not null)
        {
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
        }
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;
        var result = await Auth.LoginAsync(_model.Username, _model.Password);
        _busy = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
        }
        else
        {
            _error = result.Problem!.Message;
        }
    }

    /// <summary>Only local paths – never redirect to another site after login.</summary>
    private string SafeReturnUrl() =>
        string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.Contains("://", StringComparison.Ordinal) || ReturnUrl.StartsWith("//", StringComparison.Ordinal) || ReturnUrl.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : ReturnUrl;

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }
}
