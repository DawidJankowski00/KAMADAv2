<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Kamada.Shared.Contracts\Kamada.Shared.Contracts.csproj" />
    <ProjectReference Include="..\Kamada.Web.Admin\Kamada.Web.Admin.csproj" />
    <ProjectReference Include="..\Kamada.Web.Shared\Kamada.Web.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- The accuracy page of the on-device assistant runs the same cases as the server evals. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\benchmarks\Kamada.Assistant.Evals\cases.json" LogicalName="assistant-eval-cases.json" />
  </ItemGroup>

  <!-- Development only: models of the on-device assistant come from a static server (see docs/on-device-assistant.md). -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="wwwroot\appsettings.Development.json" />
  </ItemGroup>
</Project>
