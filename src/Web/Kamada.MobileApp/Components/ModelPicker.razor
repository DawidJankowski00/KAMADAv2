@using Kamada.Web.Shared.Assistant

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-1">@Title</MudText>
    <MudRadioGroup T="string" Value="Selected.Id" ValueChanged="SelectAsync">
    @foreach (var model in Models)
    {
        var installed = Installed.Contains(model.Id);
        var downloading = Busy?.Id == model.Id;
        <div class="d-flex align-center gap-2 py-1">
            <MudRadio Value="@model.Id" Color="Color.Primary" Disabled="@(Busy is not null)" />
            <div class="flex-grow-1" style="min-width: 0">
                <MudText Typo="Typo.body2"><b>@model.Title</b> · ok. @model.DownloadMb MB</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@model.Description</MudText>
                @if (downloading && Progress is { } progress)
                {
                    <MudProgressLinear Value="@(progress.Fraction * 100)" Color="Color.Info" Class="my-1" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@progress.Text</MudText>
                }
            </div>
            @if (installed)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check" Class="ma-0">Pobrany</MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Disabled="@(Busy is not null)"
                               OnClick="() => OnDelete.InvokeAsync(model)" aria-label="@($"Usuń {model.Title}")" />
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Busy is not null)" OnClick="() => OnDownload.InvokeAsync(model)">Pobierz</MudButton>
            }
        </div>
    }
    </MudRadioGroup>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<LocalModel> Models { get; set; } = [];

    [Parameter, EditorRequired] public LocalModel Selected { get; set; } = default!;

    [Parameter, EditorRequired] public ISet<string> Installed { get; set; } = default!;

    /// <summary>The model being downloaded, if any (one download at a time).</summary>
    [Parameter] public LocalModel? Busy { get; set; }

    [Parameter] public DownloadProgress? Progress { get; set; }

    [Parameter] public EventCallback<LocalModel> OnSelect { get; set; }

    [Parameter] public EventCallback<LocalModel> OnDownload { get; set; }

    [Parameter] public EventCallback<LocalModel> OnDelete { get; set; }

    private Task SelectAsync(string id) => OnSelect.InvokeAsync(Models.First(m => m.Id == id));
}
