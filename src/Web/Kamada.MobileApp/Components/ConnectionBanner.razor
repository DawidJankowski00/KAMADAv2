@* Shown under the app bar while the connection to the server is poor or gone. *@
@using Kamada.Web.Shared.Connectivity
@using Kamada.Web.Shared.Offline
@implements IDisposable
@inject ConnectionMonitor Monitor
@inject OrderOutbox Outbox

@if (Monitor.Quality != ConnectionQuality.Good)
{
    <div class="kamada-connection-banner @(Monitor.Quality == ConnectionQuality.Offline ? "offline" : "poor")" role="status">
        <MudIcon Icon="@(Monitor.Quality == ConnectionQuality.Offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.NetworkCheck)" Size="Size.Small" />
        <span class="flex-grow-1">@Text</span>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Disabled="_checking" OnClick="CheckAsync">Sprawdź</MudButton>
    </div>
}

@code {
    private bool _checking;

    private string Text => Monitor.Quality == ConnectionQuality.Offline
        ? "Brak połączenia" + (Outbox.Entries.Count > 0 ? Waiting : LastContact)
        : "Słabe połączenie z serwerem" + Waiting;

    private string Waiting => Outbox.Entries.Count > 0 ? $" · do wysłania: {Outbox.Entries.Count}" : string.Empty;

    private string LastContact => Monitor.LastContactAt is { } at ? $" (ostatnio {Labels.Time(at)})" : string.Empty;

    protected override void OnInitialized()
    {
        Monitor.QualityChanged += OnQualityChanged;
        Outbox.Changed += OnOutboxChanged;
    }

    public void Dispose()
    {
        Monitor.QualityChanged -= OnQualityChanged;
        Outbox.Changed -= OnOutboxChanged;
    }

    private void OnOutboxChanged() => InvokeAsync(StateHasChanged);

    private void OnQualityChanged(ConnectionQuality quality) => InvokeAsync(StateHasChanged);

    private async Task CheckAsync()
    {
        _checking = true;
        try
        {
            await Monitor.CheckAsync();
        }
        finally
        {
            _checking = false;
        }
    }
}
