{
  "ConnectionStrings": {
    "Kamada": "Host=localhost;Port=5432;Database=kamada;Username=kamada;Password=kamada_dev;Gss Encryption Mode=Disable"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "Assistant": {
    "Enabled": true
  },
  "Jwt": {
    // Demo-only placeholder key for local development. Use a real secret outside development.
    "SigningKey": "development-only-signing-key-change-me-0123456789"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5081", "http://localhost:5082" ]
  },
  "Auth": {
    "PasswordReset": {
      // Page of the web panel that sets the new password (the e-mail link adds ?token=...).
      "Url": "http://localhost:5081/reset-password"
    }
  },
  "Email": {
    // Mailpit (docker compose up -d mailpit): catches every e-mail, web UI at http://localhost:8025
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  }
}
