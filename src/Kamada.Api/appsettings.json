{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kamada": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Jwt": {
    "Issuer": "kamada-api",
    "Audience": "kamada-clients",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "CacheDuration": "1.00:00:00",
    "Nominatim": {
      "BaseUrl": "https://nominatim.openstreetmap.org/",
      "UserAgent": "KAMADA-demo/1.0 (+https://github.com/DawidJankowski00/KAMADAv2)",
      "MinDelayBetweenRequests": "00:00:01"
    },
    "Google": {
      "ApiKey": ""
    }
  },
  "Delivery": {
    "ServiceTimePerStop": "00:03:00",
    "TimeZone": "Europe/Warsaw"
  },
  "RouteOptimization": {
    "MatrixProvider": "Osrm",
    "FallbackToHaversine": true,
    "MatrixCacheDuration": "06:00:00",
    "MaxStops": 60,
    "BruteForceMaxStops": 8,
    "HeldKarpMaxStops": 15,
    "HeuristicTimeLimit": "00:00:01",
    "Osrm": {
      "BaseUrl": "https://router.project-osrm.org/",
      "Profile": "driving",
      "MinDelayBetweenRequests": "00:00:01",
      "UserAgent": "KAMADA-demo/1.0 (+https://github.com/DawidJankowski00/KAMADAv2)"
    },
    "Google": {
      "ApiKey": ""
    },
    "Haversine": {
      "CircuityFactor": 1.3,
      "AverageSpeedKmh": 30
    }
  },
  "GoogleMaps": {
    "MaxWaypointsPerLink": 9,
    "TravelMode": "driving"
  },
  "Assistant": {
    "Enabled": false,
    "MaxTextLength": 2000,
    "Ollama": {
      "BaseUrl": "http://localhost:11434/",
      "Model": "gemma3:4b",
      "RequestTimeout": "00:02:00"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    },
    "Assistant": {
      "PermitLimit": 20,
      "Window": "00:01:00"
    }
  }
}
